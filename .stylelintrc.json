{
  "extends": ["stylelint-config-recommended"],
  "rules": {
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Klassennamen müssen kebab-case mit BEM sein (block, block__element, block--modifier, block__element--modifier).",
        "severity": "warning"
      }
    ],
    "selector-max-specificity": ["0,4,0", { "severity": "warning" }],
    "declaration-no-important": [true, { "severity": "warning" }],
    "no-duplicate-selectors": [true, { "severity": "warning" }],
    "color-no-invalid-hex": true,
    "no-descending-specificity": null,
    "selector-disallowed-list": [
      ["/^\\.btn-(primary|secondary|warning|info|light|dark|success|danger|sm|lg|pill|block|link)$/"],
      { "message": "Bootstrap btn-* Varianten nicht erlaubt; stattdessen app-btn-* verwenden.", "severity": "warning" }
    ],
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-color|border|border-color|border-top-color|border-right-color|border-bottom-color|border-left-color|outline|outline-color|fill|stroke|box-shadow|text-shadow|caret-color)$/": [
        "/#[0-9a-fA-F]{3,8}/"
      ]
    }
  },
  "overrides": [
    {
      "files": ["**/app-theme.css"],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    },
    {
      "files": ["**/app-utils.css"],
      "rules": {
        "declaration-no-important": null,
        "selector-class-pattern": null,
        "selector-disallowed-list": null
      }
    },
    {
      "files": ["**/ITW.Personal.css"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
          { "severity": "warning", "disableFix": true }
        ],
        "declaration-no-important": null
      }
    }
  ],
  "ignoreFiles": [
    "src/ITW.Web/wwwroot/lib/**",
    "src/ITW.Web/wwwroot/css/*.bak*",
    "src/ITW.Web/wwwroot/css/*.bak_*",
    "**/node_modules/**"
  ]
}
