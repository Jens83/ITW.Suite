@using ITW.Web.ViewModels.UI
@model ITW.Web.ViewModels.Benutzer.BenutzerBereichsrolleAendernViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Mitarbeiterrechte";

    var zurueckUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : (Url.Action("Index") ?? "#");

    var headerModel = new AppPageHeaderViewModel
    {
        Eyebrow = "Berechtigungen",
        EyebrowIconCssClass = "bi bi-shield-lock",
        Title = Model.Titel,
        Description = Model.Beschreibung,
        BadgeText = Model.Benutzername,
        BadgeIconCssClass = "bi bi-person-badge"
    };
}

<div class="app-page">
    <div class="app-page-header">
        <partial name="~/Views/Shared/Komponenten/_AppPageHeader.cshtml" model="headerModel" />

        <div class="app-page-actions">
            <a href="@zurueckUrl" class="app-btn app-btn-neutral" data-app-loading-link data-app-loading-text="Übersicht wird geöffnet...">
                <i class="bi bi-arrow-left"></i>
                <span>Zurück</span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="app-surface">
                <div class="app-surface__header">
                    <div class="app-surface__heading">
                        <p class="app-surface__eyebrow">Zugriffssteuerung</p>
                        <h2 class="app-surface__title">Berechtigungen anpassen</h2>
                        <p class="app-surface__text">
                            Rollen und Führungsverantwortung werden bereichsbezogen geändert, ohne die zentrale Identity-Struktur zu vermischen.
                        </p>
                    </div>
                </div>

                <div class="app-surface__body pt-0">
                    <form asp-action="RolleAendern" method="post" data-app-loading-form data-app-loading-text="Berechtigungen werden gespeichert...">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="ReturnUrl" type="hidden" />

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <div class="app-static-field">
                                    <label class="app-static-field__label">Benutzername</label>
                                    <div class="app-static-field__value app-static-field__value--muted">@Model.Benutzername</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="app-static-field">
                                    <label class="app-static-field__label">E-Mail</label>
                                    <div class="app-static-field__value app-static-field__value--muted">@(string.IsNullOrWhiteSpace(Model.Email) ? "Keine E-Mail hinterlegt" : Model.Email)</div>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Rolle" class="form-label"></label>
                                <div class="itw-input-wrapper shadow-sm">
                                    <i class="bi bi-shield-check"></i>
                                    <select asp-for="Rolle" asp-items="Model.RollenOptionen" class="form-select"></select>
                                </div>
                                <span asp-validation-for="Rolle" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Fuehrungsverantwortung" class="form-label"></label>
                                <div class="itw-input-wrapper shadow-sm">
                                    <i class="bi bi-briefcase"></i>
                                    <select asp-for="Fuehrungsverantwortung" asp-items="Model.FuehrungsverantwortungsOptionen" class="form-select"></select>
                                </div>
                                <span asp-validation-for="Fuehrungsverantwortung" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="app-form-actions">
                            <button type="submit" class="app-btn app-btn-accent">
                                <i class="bi bi-save"></i>
                                <span>Änderungen speichern</span>
                            </button>

                            <a href="@zurueckUrl" class="app-btn app-btn-neutral">
                                <span>Abbrechen</span>
                            </a>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="app-surface h-100">
                <div class="app-surface__header app-surface__header--compact">
                    <div class="app-surface__heading">
                        <p class="app-surface__eyebrow">Bedeutung</p>
                        <h2 class="app-surface__title">Was hier gesteuert wird</h2>
                        <p class="app-surface__text">
                            Änderungen wirken immer nur im aktuell bearbeiteten Bereich und nicht global über alle Fachbereiche hinweg.
                        </p>
                    </div>
                </div>

                <div class="app-surface__body pt-0">
                    <ul class="app-info-list">
                        <li class="app-info-list__item">
                            <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                            <span><strong>Rolle:</strong> Definiert die Zugriffsrechte innerhalb des jeweiligen Fachbereichs.</span>
                        </li>

                        <li class="app-info-list__item">
                            <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                            <span><strong>Führung:</strong> Steuert leitende Aufgaben und erweiterte Einsichtsrechte im Bereich.</span>
                        </li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}