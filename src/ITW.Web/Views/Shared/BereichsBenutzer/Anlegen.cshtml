@using ITW.Web.ViewModels.UI
@model ITW.Web.ViewModels.Benutzer.BenutzerBereichszuordnungErfassenViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Mitarbeiter zuordnen";

    var zurueckUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : (Url.Action("Index") ?? "#");

    var headerModel = new AppPageHeaderViewModel
    {
        Eyebrow = "Benutzerverwaltung",
        EyebrowIconCssClass = "bi bi-person-check",
        Title = Model.Titel,
        Description = Model.Beschreibung,
        BadgeText = Model.HatVerfuegbareBenutzerkonten ? "Bestehendes Konto verknüpfen" : "Aktion erforderlich",
        BadgeIconCssClass = Model.HatVerfuegbareBenutzerkonten ? "bi bi-link-45deg" : "bi bi-exclamation-circle"
    };

    var emptyStateModel = new AppEmptyStateViewModel
    {
        IconCssClass = "bi bi-person-x",
        Title = "Keine verfügbaren Benutzerkonten",
        Description = "Aktuell gibt es kein zentrales Benutzerkonto ohne primäre Bereichszuordnung. Legen Sie zuerst ein neues Benutzerkonto an.",
        PrimaryActionText = "Neues Benutzerkonto anlegen",
        PrimaryActionUrl = Url.Action("BenutzerkontoAnlegen", new { returnUrl = Model.ReturnUrl }) ?? "#",
        PrimaryActionIconCssClass = "bi bi-person-plus",
        SecondaryActionText = "Zurück",
        SecondaryActionUrl = zurueckUrl,
        SecondaryActionIconCssClass = "bi bi-arrow-left"
    };
}

<div class="app-page">
    <div class="app-page-header">
        <partial name="~/Views/Shared/Komponenten/_AppPageHeader.cshtml" model="headerModel" />

        <div class="app-page-actions">
            <a href="@zurueckUrl" class="app-btn app-btn-neutral" data-app-loading-link data-app-loading-text="Übersicht wird geöffnet...">
                <i class="bi bi-arrow-left"></i>
                <span>Zurück</span>
            </a>
        </div>
    </div>

    @if (!Model.HatVerfuegbareBenutzerkonten)
    {
        <section class="app-surface">
            <partial name="~/Views/Shared/Komponenten/_AppEmptyState.cshtml" model="emptyStateModel" />
        </section>
    }
    else
    {
        <div class="row g-4">
            <div class="col-12 col-xl-8">
                <section class="app-surface">
                    <div class="app-surface__header">
                        <div class="app-surface__heading">
                            <p class="app-surface__eyebrow">Zuordnung</p>
                            <h2 class="app-surface__title">Bestehendes Benutzerkonto zuordnen</h2>
                            <p class="app-surface__text">
                                Wählen Sie ein zentrales Benutzerkonto ohne primäre Bereichszuordnung und legen Sie Rolle und Führungsverantwortung direkt mit fest.
                            </p>
                        </div>
                    </div>

                    <div class="app-surface__body pt-0">
                        <form asp-action="Anlegen" method="post" data-app-loading-form data-app-loading-text="Zuordnung wird gespeichert...">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                            <input asp-for="ReturnUrl" type="hidden" />

                            <div class="row g-4">
                                <div class="col-12">
                                    <label asp-for="UserId" class="form-label"></label>
                                    <div class="itw-input-wrapper shadow-sm">
                                        <i class="bi bi-people"></i>
                                        <select asp-for="UserId" asp-items="Model.BenutzerkontoOptionen" class="form-select"></select>
                                    </div>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Rolle" class="form-label"></label>
                                    <div class="itw-input-wrapper shadow-sm">
                                        <i class="bi bi-shield-lock"></i>
                                        <select asp-for="Rolle" asp-items="Model.RollenOptionen" class="form-select"></select>
                                    </div>
                                    <span asp-validation-for="Rolle" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Fuehrungsverantwortung" class="form-label"></label>
                                    <div class="itw-input-wrapper shadow-sm">
                                        <i class="bi bi-briefcase"></i>
                                        <select asp-for="Fuehrungsverantwortung" asp-items="Model.FuehrungsverantwortungsOptionen" class="form-select"></select>
                                    </div>
                                    <span asp-validation-for="Fuehrungsverantwortung" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="app-form-actions">
                                <button type="submit" class="app-btn app-btn-accent">
                                    <i class="bi bi-save"></i>
                                    <span>Zuordnung speichern</span>
                                </button>

                                <a href="@zurueckUrl" class="app-btn app-btn-neutral">
                                    <span>Abbrechen</span>
                                </a>
                            </div>
                        </form>
                    </div>
                </section>
            </div>

            <div class="col-12 col-xl-4">
                <section class="app-surface h-100">
                    <div class="app-surface__header app-surface__header--compact">
                        <div class="app-surface__heading">
                            <p class="app-surface__eyebrow">Information</p>
                            <h2 class="app-surface__title">So bleibt es jetzt einfach</h2>
                            <p class="app-surface__text">
                                Benutzerkonten werden wieder direkt dem Bereich zugeordnet. Module hängen separat an Bereich und Rolle.
                            </p>
                        </div>
                    </div>

                    <div class="app-surface__body pt-0">
                        <ul class="app-info-list">
                            <li class="app-info-list__item">
                                <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                                <span>Technische UserIds werden weiterhin nicht manuell erfasst, sondern direkt aus verfügbaren Konten ausgewählt.</span>
                            </li>

                            <li class="app-info-list__item">
                                <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                                <span>Module werden danach getrennt über Bereich und Rolle freigeschaltet.</span>
                            </li>

                            <li class="app-info-list__item">
                                <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                                <span>Wenn kein Konto verfügbar ist, legen Sie zuerst ein neues Benutzerkonto an und kehren anschließend hierher zurück.</span>
                            </li>
                        </ul>

                        <div class="app-form-actions mt-4">
                            <a asp-action="BenutzerkontoAnlegen"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="app-btn app-btn-outline-accent w-100 justify-content-center">
                                <i class="bi bi-person-plus"></i>
                                <span>Neues Benutzerkonto anlegen</span>
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}