@model ITW.Web.ViewModels.Layout.BereichsBenutzerMenuViewModel

@{
    var aktuellerBenutzername = User.Identity?.Name;
    if (string.IsNullOrWhiteSpace(aktuellerBenutzername))
    {
        aktuellerBenutzername = "Benutzer";
    }

    var vorname = User.FindFirst("FirstName")?.Value?.Trim() ?? string.Empty;
    var nachname = User.FindFirst("LastName")?.Value?.Trim() ?? string.Empty;

    var anzeigeName = $"{vorname} {nachname}".Trim();
    if (string.IsNullOrWhiteSpace(anzeigeName))
    {
        anzeigeName = aktuellerBenutzername;
    }

    string avatarSeed;
    if (!string.IsNullOrWhiteSpace(vorname) && !string.IsNullOrWhiteSpace(nachname))
    {
        avatarSeed = $"{char.ToUpperInvariant(vorname[0])} {char.ToUpperInvariant(nachname[0])}";
    }
    else if (!string.IsNullOrWhiteSpace(vorname))
    {
        avatarSeed = char.ToUpperInvariant(vorname[0]).ToString();
    }
    else if (!string.IsNullOrWhiteSpace(nachname))
    {
        avatarSeed = char.ToUpperInvariant(nachname[0]).ToString();
    }
    else
    {
        avatarSeed = aktuellerBenutzername;
    }

    var avatarName = Uri.EscapeDataString(avatarSeed);
}

<div class="itw-user-menu dropdown">
    <a href="#"
       class="itw-user-menu__toggle"
       data-bs-toggle="dropdown"
       aria-expanded="false"
       aria-haspopup="true">
        <img src="https://ui-avatars.com/api/?name=@avatarName&background=@Model.AvatarBackgroundColor&color=@Model.AvatarTextColor&bold=true"
             width="32"
             height="32"
             class="itw-user-menu__avatar"
             alt="@anzeigeName" />

        <span class="itw-user-menu__name">@anzeigeName</span>
        <i class="bi bi-chevron-down itw-user-menu__chevron" aria-hidden="true"></i>
    </a>

    <div class="itw-user-menu__dropdown dropdown-menu dropdown-menu-end">
        <div class="itw-user-menu__header">
            <div class="itw-user-menu__display-name">@anzeigeName</div>
            <div class="itw-user-menu__display-area">@Model.Bereichsanzeige</div>
        </div>

        <hr class="itw-user-menu__divider" />

        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="itw-user-menu__action itw-user-menu__action--danger">
                <i class="bi bi-box-arrow-right"></i>
                Abmelden
            </button>
        </form>
    </div>
</div>
