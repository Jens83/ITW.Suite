<text>
    @* Preconnects — kritische externe Domains frühzeitig verbinden *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin="anonymous" />

    @* Plus Jakarta Sans — als <link> statt @import (kein doppelter Round-Trip) *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />

    @* Bootstrap Icons (Icon-Font, kein JS-Konflikt) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/app-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-utils.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-modules.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ITW.Personal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ITW.Dienstplan.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ITW.Fahrzeugmanagement.css" asp-append-version="true" />

    @* PWA-Konfiguration *@
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#f59e0b" />
    <meta name="application-name" content="ITW NB" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ITW NB" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/pwa/apple-touch-icon-180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/pwa/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/img/pwa/icon-512.png" />
</text>
