@using ITW.Application.Organisation.Contracts
@using ITW.Application.Personnel.Urlaub.Contracts
@using ITW.Application.Users.CountOffenePasswortResetAnfragen
@using ITW.Dienstplan.Application.Contracts
@using ITW.Web.Security.PasswordReset
@model ITW.Web.ViewModels.Navigation.BereichsNavigationViewModel
@inject ITW.Web.Security.CurrentUser.ICurrentUserContextAccessor CurrentUserContextAccessor
@inject CountOffenePasswortResetAnfragenService CountOffenePasswortResetAnfragenService
@inject IDienstplanPeriodeRepository DienstplanPeriodeRepository
@inject IMitarbeiterUrlaubszeitraumRepository UrlaubszeitraumRepository

@{
    var areaName = ViewContext.RouteData.Values["area"]?.ToString();
    var aktuellerController = ViewContext.RouteData.Values["controller"]?.ToString();
    var aktuelleAction = ViewContext.RouteData.Values["action"]?.ToString();

    var aktuellerBereich = ErmittleBereichAusAreaName(areaName);
    var currentUserLookup = await CurrentUserContextAccessor.GetCurrentAsync();

    var zeigePasswortResetEintrag = false;
    var offenePasswortResetAnfragen = 0;

    if (aktuellerBereich != OrganisationsbereichCode.Unbekannt &&
        currentUserLookup.IsSuccess &&
        currentUserLookup.CurrentUser is not null &&
        PasswortResetVerantwortungHelper.DarfAnfragenBearbeiten(
            currentUserLookup.CurrentUser,
            aktuellerBereich))
    {
        zeigePasswortResetEintrag = true;
        var countResult = await CountOffenePasswortResetAnfragenService.ExecuteAsync(
            new CountOffenePasswortResetAnfragenQuery(aktuellerBereich));
        if (countResult.IsSuccess)
            offenePasswortResetAnfragen = countResult.Anzahl;
    }

    var zeigeDienstplanBadge = false;
    var offeneDienstplanPerioden = 0;

    if (aktuellerBereich == OrganisationsbereichCode.Intensivtransport &&
        currentUserLookup.IsSuccess &&
        currentUserLookup.CurrentUser is not null &&
        (currentUserLookup.CurrentUser.Rolle == BereichsrolleCode.Mitarbeiter ||
         currentUserLookup.CurrentUser.Rolle == BereichsrolleCode.Wachleiter))
    {
        zeigeDienstplanBadge = true;
        offeneDienstplanPerioden = await DienstplanPeriodeRepository.CountOffeneAsync();
    }

    var urlaubsBadgeAnzahl = 0;

    if (aktuellerBereich == OrganisationsbereichCode.Intensivtransport &&
        currentUserLookup.IsSuccess &&
        currentUserLookup.CurrentUser is not null &&
        currentUserLookup.CurrentUser.Rolle == BereichsrolleCode.Mitarbeiter)
    {
        try
        {
            urlaubsBadgeAnzahl = await UrlaubszeitraumRepository.GetAnzahlUnbestaetigenEntscheideAsync(
                currentUserLookup.CurrentUser.UserId);
        }
        catch
        {
            // Badge-Abfrage schlägt nicht fehl (z.B. fehlende Spalte nach Migration)
        }
    }

    var istPasswortResetAktiv =
        string.Equals(aktuellerController, "PasswortReset", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(aktuelleAction, "Index", StringComparison.OrdinalIgnoreCase);

    var sektionen = Model.Sektionen.Where(x => x.Eintraege.Any()).ToList();
}

@for (int si = 0; si < sektionen.Count; si++)
{
    var sektion = sektionen[si];
    var sektionId = $"itw-dg-{si}";
    var hatAktiven = sektion.Eintraege.Any(e => e.IstAktiv);
    var ersterEintrag = sektion.Eintraege.First();

    <div class="itw-dg">
        @{
            var hatPlanungsHinweis = sektion.Titel == "Planung"
                && (urlaubsBadgeAnzahl > 0 || offeneDienstplanPerioden > 0);
        }
        <button type="button"
                class="itw-dg-hd @(hatAktiven ? "active" : "collapsed")"
                data-drawer-toggle="@sektionId"
                aria-expanded="@(hatAktiven ? "true" : "false")">
            <span class="itw-dg-icon-wrap">
                <i class="@ersterEintrag.IconCssClass itw-dg-hi" aria-hidden="true"></i>
                @if (hatPlanungsHinweis)
                {
                    <span class="itw-dg-notify-dot"></span>
                }
            </span>
            <span class="itw-dg-lbl">@sektion.Titel</span>
            <i class="bi bi-chevron-down itw-dg-chev" aria-hidden="true"></i>
        </button>
        <div class="itw-dg-body @(hatAktiven ? "" : "collapsed")" id="@sektionId">
            @foreach (var eintrag in sektion.Eintraege)
            {
                var istDienstplanEintrag =
                    zeigeDienstplanBadge &&
                    string.Equals(eintrag.Controller, "Dienstplan", StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(eintrag.Action, "Index", StringComparison.OrdinalIgnoreCase);

                var istMeinUrlaubEintrag =
                    string.Equals(eintrag.Controller, "MitarbeiterUrlaub", StringComparison.OrdinalIgnoreCase);

                <a class="itw-dg-item @(eintrag.IstAktiv ? "active" : "")"
                   asp-area="@eintrag.Area"
                   asp-controller="@eintrag.Controller"
                   asp-action="@eintrag.Action">
                    <i class="@eintrag.IconCssClass" aria-hidden="true"></i>
                    @eintrag.Text
                    @if (istDienstplanEintrag && offeneDienstplanPerioden > 0)
                    {
                        <span class="itw-dg-badge">@offeneDienstplanPerioden</span>
                    }
                    @if (istMeinUrlaubEintrag && urlaubsBadgeAnzahl > 0)
                    {
                        <span class="itw-dg-badge itw-dg-badge--err">@urlaubsBadgeAnzahl</span>
                    }
                </a>
            }
        </div>
    </div>
}

@if (zeigePasswortResetEintrag && !string.IsNullOrWhiteSpace(areaName))
{
    <div class="itw-dg-sep"></div>

    <a class="itw-dg-item @(istPasswortResetAktiv ? "active" : "")"
       asp-area="@areaName"
       asp-controller="PasswortReset"
       asp-action="Index">
        <i class="bi bi-key" aria-hidden="true"></i>
        Passwort-Resets
        @if (offenePasswortResetAnfragen > 0)
        {
            <span class="itw-dg-badge itw-dg-badge--err">@offenePasswortResetAnfragen</span>
        }
    </a>
}

@functions {
    private static OrganisationsbereichCode ErmittleBereichAusAreaName(string? areaName)
    {
        return areaName switch
        {
            "Intensivtransport" => OrganisationsbereichCode.Intensivtransport,
            "Verwaltung" => OrganisationsbereichCode.Verwaltung,
            "Geschaeftsfuehrung" => OrganisationsbereichCode.Vorstand,
            _ => OrganisationsbereichCode.Unbekannt
        };
    }
}
