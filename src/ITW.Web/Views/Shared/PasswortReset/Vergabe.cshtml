@using ITW.Web.ViewModels.UI
@model ITW.Web.ViewModels.Security.PasswortResetVergabeViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = Model.Titel;

    var headerModel = new AppPageHeaderViewModel
    {
        Eyebrow = "Kontosicherheit",
        EyebrowIconCssClass = "bi bi-key",
        Title = Model.Titel,
        Description = Model.Beschreibung,
        BadgeText = Model.BereichName,
        BadgeIconCssClass = "bi bi-buildings"
    };
}

<div class="app-page">
    <div class="app-page-header">
        <partial name="~/Views/Shared/Komponenten/_AppPageHeader.cshtml" model="headerModel" />

        <div class="app-page-actions">
            <a asp-action="Index" class="app-btn app-btn-neutral" data-app-loading-link data-app-loading-text="Anfragen werden geöffnet...">
                <i class="bi bi-arrow-left"></i>
                <span>Zurück</span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-8">
            <section class="app-surface">
                <div class="app-surface__header">
                    <div class="app-surface__heading">
                        <p class="app-surface__eyebrow">Offene Anfrage</p>
                        <h2 class="app-surface__title">Temporäres Passwort setzen</h2>
                        <p class="app-surface__text">
                            Das hier gesetzte Passwort wird ausschließlich für den sicheren Wiedereinstieg genutzt und erzwingt beim nächsten Login direkt eine Passwortänderung.
                        </p>
                    </div>
                </div>

                <div class="app-surface__body pt-0">
                    <div class="row g-4 mb-4">
                        <div class="col-12 col-md-6">
                            <div class="app-static-field">
                                <label class="app-static-field__label">Benutzername</label>
                                <div class="app-static-field__value app-static-field__value--muted">@Model.Benutzername</div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="app-static-field">
                                <label class="app-static-field__label">Anfrage eingegangen</label>
                                <div class="app-static-field__value app-static-field__value--muted">@Model.AngefordertAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="app-static-field">
                                <label class="app-static-field__label">Angegebener Name</label>
                                <div class="app-static-field__value app-static-field__value--muted">@Model.Vollname</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Vergabe" method="post" data-app-loading-form data-app-loading-text="Temporäres Passwort wird gesetzt...">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <input asp-for="AnfrageId" type="hidden" />
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Benutzername" type="hidden" />
                        <input asp-for="Vollname" type="hidden" />
                        <input asp-for="BereichName" type="hidden" />
                        <input asp-for="AngefordertAm" type="hidden" />

                        <div class="app-form-note mb-4">
                            Das temporäre Passwort muss dem Mitarbeiter auf sicherem Weg mitgeteilt werden. Beim nächsten Login wird der Benutzer unmittelbar zur Passwortänderung geführt.
                        </div>

                        <div class="row g-4">
                            <div class="col-12 col-md-6">
                                <label asp-for="TemporaeresPasswort" class="form-label"></label>
                                <div class="itw-input-wrapper shadow-sm">
                                    <i class="bi bi-shield-lock"></i>
                                    <input asp-for="TemporaeresPasswort" class="form-control" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="TemporaeresPasswort" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="TemporaeresPasswortBestaetigung" class="form-label"></label>
                                <div class="itw-input-wrapper shadow-sm">
                                    <i class="bi bi-shield-check"></i>
                                    <input asp-for="TemporaeresPasswortBestaetigung" class="form-control" autocomplete="new-password" />
                                </div>
                                <span asp-validation-for="TemporaeresPasswortBestaetigung" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="app-form-actions">
                            <button type="submit" class="app-btn app-btn-accent">
                                <i class="bi bi-key-fill"></i>
                                <span>Temporäres Passwort setzen</span>
                            </button>

                            <a asp-action="Index" class="app-btn app-btn-neutral">
                                <span>Zurück</span>
                            </a>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <div class="col-12 col-xl-4">
            <section class="app-surface h-100">
                <div class="app-surface__header app-surface__header--compact">
                    <div class="app-surface__heading">
                        <p class="app-surface__eyebrow">Sicherheit</p>
                        <h2 class="app-surface__title">Verbindlicher Ablauf</h2>
                        <p class="app-surface__text">
                            Die Passwortvergabe ist ein administrativer Sicherheitsvorgang und wird bewusst separat von normalen Profilbearbeitungen geführt.
                        </p>
                    </div>
                </div>

                <div class="app-surface__body pt-0">
                    <ul class="app-info-list">
                        <li class="app-info-list__item">
                            <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                            <span>Temporäre Passwörter nur sicher übermitteln und nicht ungeschützt versenden.</span>
                        </li>

                        <li class="app-info-list__item">
                            <span class="app-info-list__icon"><i class="bi bi-check2"></i></span>
                            <span>Der Mitarbeiter wird beim ersten Login nach der Vergabe sofort zur Passwortänderung verpflichtet.</span>
                        </li>
                    </ul>
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}