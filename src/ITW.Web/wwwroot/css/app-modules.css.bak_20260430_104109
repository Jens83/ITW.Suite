.itw-vehicle-detail-kpi {
    border: 1px solid var(--itw-border, #e5e7eb);
    border-radius: 1.15rem;
    background: var(--itw-surface, #ffffff);
    box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
    padding: 1rem;
}

.itw-vehicle-detail-kpi__label,
.itw-vehicle-detail-kpi__hint {
    display: block;
    color: var(--itw-muted, #64748b);
    font-size: .76rem;
    font-weight: 850;
    letter-spacing: .04em;
    text-transform: uppercase;
}

.itw-vehicle-detail-kpi__value {
    display: block;
    margin: .3rem 0 .15rem;
    color: var(--itw-text, #0f172a);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-weight: 900;
    line-height: 1.1;
}

.itw-vehicle-quick-actions {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: .85rem;
}

.itw-vehicle-quick-action {
    display: flex;
    align-items: center;
    gap: .85rem;
    min-height: 86px;
    border: 1px solid rgba(var(--accent-rgb), .16);
    border-radius: 1.15rem;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(15, 23, 42, .07);
    color: inherit;
    padding: 1rem;
    text-decoration: none;
    transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
}

    .itw-vehicle-quick-action:hover {
        border-color: rgba(var(--accent-rgb), .34);
        box-shadow: 0 16px 36px rgba(15, 23, 42, .1);
        color: inherit;
        transform: translateY(-1px);
    }

    .itw-vehicle-quick-action i {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 42px;
        height: 42px;
        border-radius: 16px;
        color: var(--accent-color, #0d6efd);
        background: rgba(var(--accent-rgb), .1);
        font-size: 1.2rem;
    }

    .itw-vehicle-quick-action strong,
    .itw-vehicle-quick-action small {
        display: block;
    }

    .itw-vehicle-quick-action strong {
        color: var(--itw-text, #0f172a);
        font-size: .98rem;
        font-weight: 900;
    }

    .itw-vehicle-quick-action small {
        margin-top: .15rem;
        color: var(--itw-muted, #64748b);
        font-weight: 650;
    }

@media (min-width: 768px) {
    .itw-vehicle-detail-kpis {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .itw-vehicle-quick-actions {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 575.98px) {
    .itw-vehicle-detail-hero {
        flex-direction: column;
    }

    .itw-vehicle-detail-hero__badges {
        justify-content: flex-start;
    }
}