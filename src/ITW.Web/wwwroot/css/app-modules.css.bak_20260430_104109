}

.app-home-grid {
    row-gap: 1.5rem;
}

    .app-home-grid > [class*="col-"] {
        display: flex;
    }

.app-home-module {
    --module-color: #2563eb;
    --module-rgb: 37, 99, 235;
    display: flex;
    width: 100%;
}

.app-home-module__card {
    width: 100%;
}

.app-home-module--itw {
    --module-color: #2563eb;
    --module-rgb: 37, 99, 235;
}

.app-home-module--admin {
    --module-color: #334155;
    --module-rgb: 51, 65, 85;
}

.app-home-module--gf {
    --module-color: #b42318;
    --module-rgb: 180, 35, 24;
}

.app-home-module__card {
    position: relative;
    height: 100%;
    border: 1px solid rgba(15, 23, 42, 0.06);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, #ffffff 100%);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, opacity 0.18s ease;
}

.app-home-module__card {
    display: flex;
    width: 100%;
}

    .app-home-module__card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--module-color) 0%, rgba(var(--module-rgb), 0.45) 100%);
    }

    .app-home-module__card:hover {
        transform: translateY(-4px);
        box-shadow: 0 22px 44px rgba(15, 23, 42, 0.12);
        border-color: rgba(var(--module-rgb), 0.16);
    }

.app-home-module__card--current {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(var(--module-rgb), 0.14);
}

.app-home-module__card--inactive {
    opacity: 0.82;
    background: linear-gradient(180deg, rgba(252, 252, 253, 1) 0%, rgba(248, 250, 252, 1) 100%);
}

    .app-home-module__card--inactive .app-home-module__icon {
        background-color: rgba(var(--module-rgb), 0.06);
        color: rgba(var(--module-rgb), 0.72);
    }

    .app-home-module__card--inactive .app-home-module__title,
    .app-home-module__card--inactive .app-home-module__text {
        color: #6b7280;
    }

    .app-home-module__card--inactive:hover {
        opacity: 0.92;
        transform: translateY(-2px);
    }

.app-home-module__body {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem;
}

.app-home-module__status {
    min-height: 2.25rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: flex-start;
    justify-content: center;
}

.app-home-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
}

.app-home-status--success {
    background-color: rgba(25, 135, 84, 0.1);
    color: #166534;
    border: 1px solid rgba(25, 135, 84, 0.16);
}

.app-home-status--muted {
    background-color: #f8fafc;
    color: #64748b;
    border: 1px solid #e2e8f0;
}

.app-home-module__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.2rem;
    height: 4.2rem;
    margin: 0 auto 1rem auto;
    border-radius: 20px;
    background-color: rgba(var(--module-rgb), 0.1);
    color: var(--module-color);
    box-shadow: inset 0 0 0 1px rgba(var(--module-rgb), 0.08);
}

    .app-home-module__icon i {
        font-size: 1.8rem;
    }

.app-home-module__title {
    margin: 0 0 0.45rem 0;
    text-align: center;
    font-size: 1.28rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.25;
}

.app-home-module__text {
    margin: 0;
    text-align: center;
    color: #64748b;
    font-size: 0.94rem;
    line-height: 1.6;
}

.app-home-module__footer {
    margin-top: auto;
    padding-top: 1.4rem;
}

.app-home-module__action {
    width: 100%;
    min-height: 48px;
}

.app-home-module__action--solid {
    background-color: var(--module-color);
    color: #ffffff;
    border-color: var(--module-color);
    box-shadow: 0 6px 16px rgba(var(--module-rgb), 0.2);
}

    .app-home-module__action--solid:hover,
    .app-home-module__action--solid:focus,
    .app-home-module__action--solid:active {
        background-color: var(--module-color);
        color: #ffffff;
        border-color: var(--module-color);
        filter: brightness(0.92);
        box-shadow: 0 8px 18px rgba(var(--module-rgb), 0.26);
    }

.app-home-module__action--outline {
    background-color: #ffffff;
    color: var(--module-color);
    border-color: rgba(var(--module-rgb), 0.34);
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
}

    .app-home-module__action--outline:hover,
    .app-home-module__action--outline:focus,
    .app-home-module__action--outline:active {
        background-color: rgba(var(--module-rgb), 0.08);
        color: var(--module-color);
        border-color: rgba(var(--module-rgb), 0.52);
        box-shadow: 0 8px 18px rgba(var(--module-rgb), 0.14);
    }

.app-home-module__action--muted {
    background-color: #f8fafc;
    color: #64748b;
    border-color: #dbe3ee;
    box-shadow: none;
}

    .app-home-module__action--muted:hover,
    .app-home-module__action--muted:focus,
    .app-home-module__action--muted:active {
        background-color: #f1f5f9;
        color: #475569;
        border-color: #cbd5e1;
        box-shadow: none;
    }

.app-home-footer {
    margin-top: 2.5rem;
    text-align: center;
    color: #94a3b8;
    font-size: 0.82rem;
}

@media (max-width: 991.98px) {
    .app-home-shell {
        padding-top: 2rem;
    }
}

@media (max-width: 575.98px) {
    .app-home-shell {
        padding: 1.35rem 0 1.2rem;
    }

    .app-home-hero {
        margin-bottom: 1.6rem;
    }

    .app-home-hero__title {
        font-size: 1.9rem;
    }

    .app-home-hero__text {
        font-size: 0.92rem;
    }

    .app-home-module__body {
        padding: 1.25rem;
    }

    .app-home-module__icon {
        width: 3.7rem;
        height: 3.7rem;
        border-radius: 18px;
    }

        .app-home-module__icon i {
            font-size: 1.55rem;
        }

    .app-home-module__title {
        font-size: 1.15rem;
    }

    .app-home-module__text {
