@model IReadOnlyList<ITW.Web.Logging.LogEintrag>

@{
    ViewData["Title"] = "Systemprotokoll";
    var aktiverFilter = ViewData["AktiverLevelFilter"] as string;
}

<div class="app-page">
    <header class="app-page-header">
        <div class="app-page-heading">
            <h1 class="app-page-heading__title">Systemprotokoll</h1>
            <p class="app-page-heading__text">Die @Model.Count neuesten Log-Einträge — neueste zuerst.</p>
        </div>
    </header>

    <section class="app-surface">
        <div class="app-surface__body">
            <div class="log-filter-bar">
                <a asp-action="Index" asp-route-level=""
                   class="app-btn app-btn-sm @(aktiverFilter is null ? "app-btn-accent" : "app-btn-neutral")">
                    Alle
                </a>
                <a asp-action="Index" asp-route-level="Information"
                   class="app-btn app-btn-sm @(aktiverFilter == "Information" ? "app-btn-accent" : "app-btn-neutral")">
                    <i class="bi bi-info-circle"></i> Info
                </a>
                <a asp-action="Index" asp-route-level="Warning"
                   class="app-btn app-btn-sm @(aktiverFilter == "Warning" ? "app-btn-accent" : "app-btn-neutral")">
                    <i class="bi bi-exclamation-triangle"></i> Warnung
                </a>
                <a asp-action="Index" asp-route-level="Error"
                   class="app-btn app-btn-sm @(aktiverFilter == "Error" ? "app-btn-accent" : "app-btn-neutral")">
                    <i class="bi bi-x-circle"></i> Fehler
                </a>
                <a asp-action="Index" asp-route-level="Fatal"
                   class="app-btn app-btn-sm @(aktiverFilter == "Fatal" ? "app-btn-accent" : "app-btn-neutral")">
                    <i class="bi bi-radiation"></i> Fatal
                </a>
            </div>

            @if (Model.Count == 0)
            {
                <p class="app-overline">Keine Log-Einträge gefunden.@(aktiverFilter is not null ? $" (Filter: {aktiverFilter})" : "")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="app-table app-table--compact">
                        <thead>
                            <tr>
                                <th style="width:160px">Zeitstempel</th>
                                <th style="width:100px">Level</th>
                                <th style="width:180px">Quelle</th>
                                <th>Nachricht</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eintrag in Model)
                            {
                                <tr class="log-row log-row--@eintrag.Level.ToLowerInvariant()">
                                    <td class="app-table__subtext" style="white-space:nowrap">
                                        @eintrag.Zeitstempel.ToLocalTime().ToString("dd.MM. HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="app-pill log-pill--@eintrag.Level.ToLowerInvariant()">
                                            @eintrag.Level
                                        </span>
                                    </td>
                                    <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                                        title="@eintrag.Quelle">
                                        <span class="app-table__subtext">@eintrag.Quelle</span>
                                    </td>
                                    <td>
                                        @eintrag.Nachricht
                                        @if (!string.IsNullOrWhiteSpace(eintrag.Ausnahme))
                                        {
                                            <details class="log-exception">
                                                <summary class="log-exception__toggle">Fehlerdetails</summary>
                                                <pre class="log-exception__pre">@eintrag.Ausnahme</pre>
                                            </details>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
