@model IReadOnlyList<ITW.Web.Logging.LogEintrag>

@{
    ViewData["Title"] = "Systemprotokoll";
    var aktiverFilter = ViewData["AktiverLevelFilter"] as string;
}

<div class="app-page">
    <div class="app-page-header">
        <div class="app-page-header__content">
            <div class="app-page-header__label">
                <i class="bi bi-shield-check"></i>
                System
            </div>
            <h1 class="app-page-header__title">Systemprotokoll</h1>
            <p class="app-page-header__subtitle">
                Die @Model.Count neuesten Log-Einträge — neueste zuerst.
            </p>
        </div>
    </div>

    <section class="app-surface">
        <div class="app-surface__body">
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-action="Index" asp-route-level=""
                   class="app-btn app-btn-sm @(aktiverFilter is null ? "app-btn-accent" : "app-btn-neutral")">
                    Alle
                </a>
                <a asp-action="Index" asp-route-level="Information"
                   class="app-btn app-btn-sm @(aktiverFilter == "Information" ? "app-btn-accent" : "app-btn-neutral")">
                    <i class="bi bi-info-circle"></i> Info
                </a>
                <a asp-action="Index" asp-route-level="Warning"
                   class="app-btn app-btn-sm @(aktiverFilter == "Warning" ? "app-btn-accent" : "app-btn-neutral") log-level-warning">
                    <i class="bi bi-exclamation-triangle"></i> Warnung
                </a>
                <a asp-action="Index" asp-route-level="Error"
                   class="app-btn app-btn-sm @(aktiverFilter == "Error" ? "app-btn-accent" : "app-btn-neutral") log-level-error">
                    <i class="bi bi-x-circle"></i> Fehler
                </a>
                <a asp-action="Index" asp-route-level="Fatal"
                   class="app-btn app-btn-sm @(aktiverFilter == "Fatal" ? "app-btn-accent" : "app-btn-neutral") log-level-fatal">
                    <i class="bi bi-radiation"></i> Fatal
                </a>
            </div>

            @if (Model.Count == 0)
            {
                <div class="app-form-note">
                    Keine Log-Einträge gefunden.
                    @if (aktiverFilter is not null)
                    {
                        <text> (Filter: <strong>@aktiverFilter</strong>)</text>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="app-table app-table-sm">
                        <thead>
                            <tr>
                                <th style="width:160px">Zeitstempel</th>
                                <th style="width:90px">Level</th>
                                <th style="width:180px">Quelle</th>
                                <th>Nachricht</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var eintrag in Model)
                            {
                                <tr class="log-row log-level-@eintrag.Level.ToLowerInvariant()">
                                    <td class="log-ts text-nowrap">
                                        @eintrag.Zeitstempel.ToLocalTime().ToString("dd.MM. HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="log-badge log-badge-@eintrag.Level.ToLowerInvariant()">
                                            @eintrag.Level
                                        </span>
                                    </td>
                                    <td class="text-truncate" style="max-width:180px" title="@eintrag.Quelle">
                                        @eintrag.Quelle
                                    </td>
                                    <td>
                                        <span class="log-message">@eintrag.Nachricht</span>
                                        @if (!string.IsNullOrWhiteSpace(eintrag.Ausnahme))
                                        {
                                            <details class="mt-1">
                                                <summary class="log-exception-toggle">Fehlerdetails anzeigen</summary>
                                                <pre class="log-exception-pre">@eintrag.Ausnahme</pre>
                                            </details>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .log-badge {
        display: inline-block;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .log-badge-information { background: var(--info-color, #0ea5e9); color: #fff; }
    .log-badge-warning     { background: var(--warning-color, #f59e0b); color: #fff; }
    .log-badge-error       { background: var(--error-color, #ef4444); color: #fff; }
    .log-badge-fatal       { background: #7c3aed; color: #fff; }
    .log-badge-debug       { background: var(--text-color-muted, #64748b); color: #fff; }
    .log-badge-verbose     { background: var(--text-color-subtle, #94a3b8); color: #fff; }

    .log-row.log-level-error td,
    .log-row.log-level-fatal td { background-color: color-mix(in srgb, var(--error-color, #ef4444) 8%, transparent); }
    .log-row.log-level-warning td { background-color: color-mix(in srgb, var(--warning-color, #f59e0b) 8%, transparent); }

    .log-exception-toggle { cursor: pointer; font-size: 0.8rem; color: var(--text-color-muted, #64748b); }
    .log-exception-pre {
        font-size: 0.75rem;
        background: var(--surface-color-subtle, #f1f5f9);
        padding: 8px;
        border-radius: 4px;
        overflow-x: auto;
        max-height: 200px;
        white-space: pre-wrap;
        word-break: break-all;
    }
</style>
