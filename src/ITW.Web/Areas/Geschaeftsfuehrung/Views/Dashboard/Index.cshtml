@{
    ViewData["Title"] = "Startseite";
}

<div class="app-dashboard-page">
    <div class="app-dashboard-header">
        <div class="app-dashboard-header__content">
            <div class="app-dashboard-header__label">
                <i class="bi bi-graph-up-arrow"></i>
                Geschäftsführung
            </div>

            <h1 class="app-dashboard-header__title">Management Dashboard</h1>
            <p class="app-dashboard-header__text">
                Strategische Steuerung, Personalübersicht und zentrale Zuweisung der Module an Bereiche und Rollen.
            </p>
        </div>

        <div class="app-dashboard-header__badge">
            <i class="bi bi-bar-chart-line"></i>
            Bereich Geschäftsführung
        </div>
    </div>

    <div class="row app-dashboard-grid">
        <div class="col-12 col-md-6 col-xl-4">
            <article class="app-dashboard-card">
                <div class="app-dashboard-card__body">
                    <div class="app-dashboard-card__meta">Systemsteuerung</div>

                    <div class="app-dashboard-card__top">
                        <div class="app-dashboard-card__icon">
                            <i class="bi bi-diagram-3"></i>
                        </div>

                        <div>
                            <h2 class="app-dashboard-card__title">Module</h2>
                            <p class="app-dashboard-card__text">
                                Legen Sie fest, welche Rollen in welchen Bereichen ein Modul erhalten.
                            </p>
                        </div>
                    </div>

                    <div class="app-dashboard-card__footer">
                        <a asp-area="Geschaeftsfuehrung"
                           asp-controller="Module"
                           asp-action="Index"
                           class="btn-outline-accent app-dashboard-action"
                           data-app-loading-link
                           data-app-loading-text="Modulverwaltung wird geöffnet...">
                            <i class="bi bi-sliders"></i>
                            Modulverwaltung öffnen
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </article>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <article class="app-dashboard-card">
                <div class="app-dashboard-card__body">
                    <div class="app-dashboard-card__meta">Organisation</div>

                    <div class="app-dashboard-card__top">
                        <div class="app-dashboard-card__icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <h2 class="app-dashboard-card__title">Personal</h2>
                            <p class="app-dashboard-card__text">
                                Personalübersicht und bereichsbezogene Benutzerverwaltung der Geschäftsführung öffnen.
                            </p>
                        </div>
                    </div>

                    <div class="app-dashboard-card__footer">
                        <a asp-area="Geschaeftsfuehrung"
                           asp-controller="Benutzer"
                           asp-action="Index"
                           class="btn-outline-accent app-dashboard-action"
                           data-app-loading-link
                           data-app-loading-text="Personalübersicht wird geöffnet...">
                            <i class="bi bi-person-lines-fill"></i>
                            Personalübersicht öffnen
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</div>