@using ITW.Web.ViewModels.UI
@model ITW.Web.Areas.Intensivtransport.ViewModels.Mitarbeiter.MitarbeiterDokumenteViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Mitarbeiterdokumente";

    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();

    var headerModel = new AppPageHeaderViewModel
    {
        Eyebrow = "Personal",
        EyebrowIconCssClass = "bi bi-file-earmark-text",
        Title = Model.Titel,
        Description = Model.Beschreibung,
        BadgeText = $"{Model.Dokumente.Count} Dokumente",
        BadgeIconCssClass = "bi bi-folder2-open"
    };
}

<div class="app-page">
    <div class="app-page-header">
        <partial name="~/Views/Shared/Komponenten/_AppPageHeader.cshtml" model="headerModel" />

        <div class="app-page-actions">
            <a asp-action="Details"
               asp-route-userId="@Model.UserId"
               class="app-btn app-btn-neutral"
               data-app-loading-link
               data-app-loading-text="Mitarbeiterdetails werden geöffnet...">
                <i class="bi bi-arrow-left"></i>
                <span>Zur Übersicht</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage) || !string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="app-status-stack">
            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                @await Html.PartialAsync(
                "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                successMessage,
                new ViewDataDictionary(ViewData)
                {
                    ["Variant"] = "success",
                    ["Title"] = "Erfolgreich gespeichert",
                    ["AutoHide"] = true,
                    ["AutoHideMilliseconds"] = 3000
                })
                }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                @await Html.PartialAsync(
                "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                errorMessage,
                new ViewDataDictionary(ViewData)
                {
                    ["Variant"] = "danger",
                    ["Title"] = "System-Hinweis",
                    ["AutoHide"] = false
                })
                }
        </div>
    }

    <div class="app-employee-detail-grid">
        <aside class="app-employee-detail-sidebar">
            <partial name="~/Areas/Intensivtransport/Views/Shared/_MitarbeiterDetailNavigation.cshtml" model="Model.Navigation" />
        </aside>

        <div class="app-employee-detail-content">
            <section class="app-employee-card">
                <header class="app-employee-card__header app-employee-card__header--row">
                    <div>
                        <h2 class="app-employee-card__title">
                            <i class="bi bi-cloud-arrow-up"></i>
                            Dokument hochladen
                        </h2>
                        <p class="app-employee-card__text">
                            Zulässig sind PDF-, Bild- und Word-Dateien. Die Dokumente werden dem Mitarbeiterprofil fachlich zugeordnet.
                        </p>
                    </div>
                </header>

                <div class="app-employee-card__body">
                    <form asp-action="DokumentHochladen" method="post" enctype="multipart/form-data" data-app-loading-form data-app-loading-text="Dokument wird hochgeladen...">
                        @Html.AntiForgeryToken()
                        <input asp-for="UserId" type="hidden" />

                        <div class="app-form-note mb-4">
                            Max. 10 MB pro Datei. Unterstützte Formate: PDF, JPG, PNG und DOCX.
                        </div>

                        <div class="app-employee-form-grid">
                            <div>
                                <label asp-for="Kategorie" class="form-label small fw-bold text-muted">Kategorie</label>
                                <select asp-for="Kategorie" asp-items="Model.KategorieOptionen" class="form-select shadow-sm">
                                    <option value="">Bitte wählen...</option>
                                </select>
                            </div>

                            <div>
                                <label asp-for="Datei" class="form-label small fw-bold text-muted">Datei</label>
                                <input asp-for="Datei" type="file" class="form-control shadow-sm" />
                            </div>
                        </div>

                        <div class="app-form-actions">
                            <button type="submit" class="app-btn app-btn-accent">
                                <i class="bi bi-upload"></i>
                                <span>Hochladen</span>
                            </button>
                        </div>
                    </form>
                </div>
            </section>

            <section class="app-employee-card">
                <header class="app-employee-card__header app-employee-card__header--row">
                    <div>
                        <h2 class="app-employee-card__title">
                            <i class="bi bi-folder2-open"></i>
                            Vorhandene Dokumente
                        </h2>
                        <p class="app-employee-card__text">
                            Alle hinterlegten Mitarbeiterdokumente werden zentral im gleichen Oberflächenmuster angezeigt.
                        </p>
                    </div>

                    <span class="app-pill app-pill--accent">@Model.Dokumente.Count Einträge</span>
                </header>

                <div class="app-employee-card__body">
                    @if (Model.Dokumente.Count == 0)
                    {
                        <div class="app-employee-documents-empty">
                            <i class="bi bi-file-earmark-x"></i>
                            <div>Noch keine Dokumente hinterlegt.</div>
                        </div>
                    }
                    else
                    {
                        <div class="app-employee-doc-grid">
                            @foreach (var dokument in Model.Dokumente)
                            {
                                var iconClass = "bi-file-earmark-text";

                                if (dokument.Inhaltstyp.Contains("pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "bi-file-earmark-pdf";
                                }
                                else if (dokument.Inhaltstyp.Contains("image", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "bi-file-earmark-image";
                                }
                                else if (dokument.Inhaltstyp.Contains("word", StringComparison.OrdinalIgnoreCase) ||
                                dokument.Inhaltstyp.Contains("officedocument", StringComparison.OrdinalIgnoreCase))
                                {
                                    iconClass = "bi-file-earmark-word";
                                }

                                <article class="app-employee-doc-card">
                                    <div class="app-employee-doc-card__icon">
                                        <i class="bi @iconClass"></i>
                                    </div>

                                    <div class="app-employee-doc-card__title" title="@dokument.Kategorie">@dokument.Kategorie</div>

                                    <div class="app-employee-doc-card__meta">
                                        @dokument.HochgeladenAm.ToString("dd.MM.yyyy")<br />
                                        @dokument.DateigroesseText
                                    </div>

                                    <div class="app-employee-doc-card__actions">
                                        <a asp-action="DokumentHerunterladen"
                                           asp-route-userId="@Model.UserId"
                                           asp-route-dokumentId="@dokument.DokumentId"
                                           class="app-btn app-btn-sm app-btn-outline-accent justify-content-center"
                                           data-app-loading-link
                                           data-app-loading-text="Dokument wird heruntergeladen..."
                                           title="Herunterladen">
                                            <i class="bi bi-download"></i>
                                            <span>Herunterladen</span>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}