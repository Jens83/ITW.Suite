@model ITW.Web.ViewModels.Personal.ItwMitarbeiterprofilListeViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Personalstamm";

    var personalIndexReturnUrl = Url.Action("Index", "Personal", new { area = "Intensivtransport" }) ?? string.Empty;

    var modelError = !Model.IsSuccess
        ? (Model.ErrorMessage ?? "Die Personaldaten konnten nicht geladen werden.")
        : null;
}

<div class="app-page">
    <header class="app-page-header">
        <div class="app-page-heading">
            <h1 class="app-page-heading__title">@Model.Titel</h1>
            <p class="app-page-heading__text">@Model.Beschreibung</p>
        </div>

        <div class="app-page-actions">
            <a asp-area="Intensivtransport"
               asp-controller="Benutzer"
               asp-action="Anlegen"
               asp-route-returnUrl="@personalIndexReturnUrl"
               class="app-btn app-btn-outline-accent"
               data-app-loading-link
               data-app-loading-text="Zuordnung wird geöffnet...">
                <i class="bi bi-person-check"></i>
                Bestehendes Konto zuordnen
            </a>

            <a asp-area="Intensivtransport"
               asp-controller="Benutzer"
               asp-action="BenutzerkontoAnlegen"
               asp-route-returnUrl="@personalIndexReturnUrl"
               class="app-btn app-btn-accent"
               data-app-loading-link
               data-app-loading-text="Benutzerkonto wird geöffnet...">
                <i class="bi bi-person-plus"></i>
                Neues Benutzerkonto
            </a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(modelError))
    {
        @await Html.PartialAsync(
            "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
            modelError,
            new ViewDataDictionary(ViewData)
            {
                ["Variant"] = "danger",
                ["Title"] = "Fehler beim Laden",
                ["AutoHide"] = false
            })
    }

    @if (Model.IsSuccess && Model.Profile.Count == 0)
    {
        <section class="app-surface">
            <div class="app-empty-state">
                <div class="app-empty-state__icon">
                    <i class="bi bi-person-x"></i>
                </div>
                <div class="app-empty-state__body">
                    <h2 class="app-empty-state__title">Noch keine Mitarbeiter vorhanden</h2>
                    <p class="app-empty-state__text">
                        Sobald Benutzer dem Bereich Intensivtransport zugeordnet sind, können hier die
                        Stammdaten und ITW-Profile gepflegt werden.
                    </p>
                </div>
            </div>
        </section>
    }
    else if (Model.IsSuccess)
    {
        <section class="app-surface">
            <div class="app-surface__header">
                <div class="app-surface__heading">
                    <p class="app-surface__eyebrow">Mitarbeiterübersicht</p>
                    <h2 class="app-surface__title">Profile im Bereich Intensivtransport</h2>
                </div>
                <span class="app-page-meta">
                    <i class="bi bi-people"></i>
                    @Model.Profile.Count Einträge
                </span>
            </div>

            <div class="app-surface__body--table">
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th class="app-table__col-first">Mitarbeiter</th>
                                <th>Status</th>
                                <th>Qualifikation</th>
                                <th>Zuletzt aktiv</th>
                                <th class="app-table__col-last app-table__col-action">Aktion</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var profil in Model.Profile)
                            {
                                <tr>
                                    <td class="app-table__col-first">
                                        <div class="app-table__title">@profil.AnzeigeName</div>
                                        <div class="app-table__subtext">
                                            @(string.IsNullOrWhiteSpace(profil.Email) ? "—" : profil.Email)
                                        </div>
                                        <div class="app-table__chips">
                                            <span class="app-pill app-pill--neutral">@profil.BeschaeftigungsartText</span>
                                            @if (profil.IstGesperrt)
                                            {
                                                <span class="app-pill app-pill--danger">Gesperrt</span>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <div class="app-table__status">
                                            <span class="app-pill @(profil.HatStammdatenprofil ? "app-pill--success" : "app-pill--warning")">
                                                <i class="bi @(profil.HatStammdatenprofil ? "bi-check" : "bi-clock")"></i>
                                                Stammdaten
                                            </span>
                                            <span class="app-pill @(profil.HatProfil ? "app-pill--success" : "app-pill--warning")">
                                                <i class="bi @(profil.HatProfil ? "bi-check" : "bi-clock")"></i>
                                                ITW-Profil
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="app-table__title">@profil.Hauptqualifikation</div>
                                        @if (profil.Zusatzqualifikationen.Count > 0)
                                        {
                                            <div class="app-table__chips">
                                                @foreach (var zusatz in profil.Zusatzqualifikationen.Take(2))
                                                {
                                                    <span class="app-pill app-pill--neutral">@zusatz</span>
                                                }
                                                @if (profil.Zusatzqualifikationen.Count > 2)
                                                {
                                                    <span class="app-pill app-pill--neutral">+@(profil.Zusatzqualifikationen.Count - 2)</span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="app-table__subtext">
                                            @(profil.ProfilAktualisiertAm.HasValue
                                                ? profil.ProfilAktualisiertAm.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                : "—")
                                        </div>
                                    </td>

                                    <td class="app-table__col-last app-table__col-action">
                                        <div class="app-table__actions">
                                            <a asp-action="Details"
                                               asp-route-userId="@profil.UserId"
                                               class="app-btn app-btn-sm app-btn-outline-accent"
                                               data-app-loading-link
                                               data-app-loading-text="Mitarbeiterdetails werden geöffnet...">
                                                Details
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
</div>
