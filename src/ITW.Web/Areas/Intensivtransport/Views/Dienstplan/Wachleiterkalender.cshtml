@using ITW.Dienstplan.Domain.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@model ITW.Web.Areas.Intensivtransport.ViewModels.Dienstplan.WachleiterWunschkalenderViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Wachleiterkalender";

    var returnUrl = Url.Action("Wachleiterkalender", "DienstplanWachleiter", new
    {
        area = "Intensivtransport",
        periodeId = Model.AusgewaehltePeriodeId
    }) ?? string.Empty;

    var modalReturnUrl = Model.PlanungsModal?.ReturnUrl ?? returnUrl;

    var modalFehler = Model.PlanungsModalAutomatischOeffnen
        ? TempData[FlashKeys.Error] as string
        : null;

    var finalSeitenFehler = !Model.IsSuccess
        ? (Model.ErrorMessage ?? "Ein Fehler ist aufgetreten.")
        : null;
}

<div class="app-pm-page">

    @* ── Header ── *@
    <div class="app-pm-header">
        <div class="app-pm-header__left">
            <h1 class="app-pm-header__title">@Model.Titel</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Beschreibung))
            {
                <p class="app-pm-header__desc">@Model.Beschreibung</p>
            }
        </div>
        <div class="app-pm-header__actions">
            <a asp-area="Intensivtransport"
               asp-controller="DienstplanWachleiter"
               asp-action="Index"
               class="app-btn app-btn-neutral">
                <i class="bi bi-arrow-left"></i>
                Periodenübersicht
            </a>
        </div>
    </div>

    @* ── Page error ── *@
    @if (!string.IsNullOrWhiteSpace(finalSeitenFehler))
    {
        @await Html.PartialAsync(
        "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
        finalSeitenFehler,
        new ViewDataDictionary(ViewData)
        {
            ["Variant"] = "danger",
            ["Title"] = "System-Hinweis",
            ["AutoHide"] = false
        })
    }

    @if (Model.AusgewaehltePeriodeId.HasValue)
    {
        @* ── Control panel ── *@
        <div class="app-surface app-wlk-ctrl">
            <div class="app-wlk-ctrl__grid">

                @* Period name *@
                <div class="app-wlk-ctrl__info">
                    <p class="app-wlk-ctrl__eyebrow">Aktueller Zeitraum</p>
                    <p class="app-wlk-ctrl__period">@Model.AusgewaehltePeriodeBezeichnung</p>
                </div>

                @* Period selector – GET to avoid 405 *@
                <form method="get"
                      asp-area="Intensivtransport"
                      asp-controller="DienstplanWachleiter"
                      asp-action="Wachleiterkalender"
                      class="app-wlk-ctrl__selector">
                    <label class="app-pm-field__label">Zeitraum wechseln</label>
                    <div class="app-wlk-ctrl__selector-row">
                        <select name="periodeId"
                                asp-items="Model.PeriodenOptionen"
                                class="app-pm-field__select"></select>
                        <button type="submit" class="app-btn app-btn-neutral app-btn-sm">
                            <i class="bi bi-arrow-clockwise"></i>
                            Laden
                        </button>
                    </div>
                </form>

                @* Status + actions *@
                <div class="app-wlk-ctrl__status">
                    <div class="app-wlk-ctrl__badges">
                        <span class="app-wlk-badge @(Model.WunschphaseIstOffen ? "app-wlk-badge--active" : "app-wlk-badge--muted")">
                            @if (Model.WunschphaseIstOffen)
                            {
                                <span class="app-wlk-pulse"></span>
                            }
                            <i class="bi @(Model.WunschphaseIstOffen ? "bi-unlock-fill" : "bi-lock-fill")"></i>
                            @(Model.WunschphaseIstOffen ? "Wunschphase offen" : "Wunschphase geschlossen")
                        </span>

                        <span class="app-wlk-badge @(Model.PlanIstFreigegeben ? "app-wlk-badge--done" : "app-wlk-badge--muted")">
                            <i class="bi @(Model.PlanIstFreigegeben ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                            @(Model.PlanIstFreigegeben ? "Freigegeben" : "Entwurf")
                        </span>
                    </div>

                    <div class="app-wlk-ctrl__actions">
                        <form asp-area="Intensivtransport"
                              asp-controller="DienstplanWachleiter"
                              asp-action="WunschphaseStatusAendern"
                              method="post"
                              data-app-loading-form
                              data-app-loading-text="Wunschphase wird aktualisiert...">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="periodeId" value="@Model.AusgewaehltePeriodeId" />
                            <input type="hidden" name="oeffnen" value="@(Model.WunschphaseIstOffen ? "false" : "true")" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="app-btn app-btn-sm @(Model.WunschphaseIstOffen ? "app-btn-neutral" : "app-btn-accent")">
                                @(Model.WunschphaseIstOffen ? "Phase beenden" : "Wunschphase öffnen")
                            </button>
                        </form>

                        @if (!Model.WunschphaseIstOffen)
                        {
                            <form asp-area="Intensivtransport"
                                  asp-controller="DienstplanWachleiter"
                                  asp-action="PlanFreigabeAendern"
                                  method="post"
                                  data-app-loading-form
                                  data-app-loading-text="Planfreigabe wird aktualisiert...">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="periodeId" value="@Model.AusgewaehltePeriodeId" />
                                <input type="hidden" name="freigeben" value="@(Model.PlanIstFreigegeben ? "false" : "true")" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="app-btn app-btn-sm @(Model.PlanIstFreigegeben ? "app-btn-neutral" : "app-btn-success")">
                                    @(Model.PlanIstFreigegeben ? "Freigabe entfernen" : "Veröffentlichen")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Calendar ── *@
        <div class="app-surface app-wlk-cal">
            <div class="app-wlk-cal__header">
                <h2 class="app-wlk-cal__title">@Model.AusgewaehltePeriodeBezeichnung</h2>
            </div>

            <div class="app-wlk-cal__body">
                <div class="app-wlk-cal__head">
                    <div>Mo</div>
                    <div>Di</div>
                    <div>Mi</div>
                    <div>Do</div>
                    <div>Fr</div>
                    <div class="wl-we">Sa</div>
                    <div class="wl-we">So</div>
                </div>

                <div class="app-wlk-cal__grid">
                    @foreach (var woche in Model.KalenderWochen)
                    {
                        foreach (var tag in woche.Tage)
                        {
                            var isInactive = !tag.IstImAktivenMonat;
                            var statusCss = !isInactive && !tag.IstFeiertag && !tag.IstWochenende
                                ? tag.WachleiterStatusCssClass
                                : string.Empty;

                            <div class="app-wlk-day @(isInactive ? "app-wlk-day--empty" : "") @(tag.IstHeute ? "app-wlk-day--today" : "") @(tag.IstWochenende ? "app-wlk-day--weekend" : "") @statusCss @(tag.HatSondereinsatz ? "app-wlk-day--sondereinsatz" : "")">
                                <div class="app-wlk-day__header">
                                    <span class="app-wlk-day__num">@tag.Datum.Day</span>
                                    @if (!isInactive && !tag.IstFeiertag && !tag.IstWochenende)
                                    {
                                        <span class="app-wlk-day__day-status">@tag.WachleiterStatusText</span>
                                    }
                                </div>

                                @if (!isInactive)
                                {
                                    <div class="app-wlk-day__body">
                                        @if (tag.HatSondereinsatz)
                                        {
                                            <div class="app-wlk-day__hint" style="background:color-mix(in srgb,var(--pri) 10%,transparent);border:1px solid color-mix(in srgb,var(--pri) 25%,transparent);color:var(--on-s);">
                                                <i class="bi bi-star-fill"></i> Sondereinsatz
                                            </div>
                                            <div class="app-wlk-day__summary">
                                                <span>NFS <strong>@tag.AnzahlGeplanteNotfallsanitaeter</strong></span>
                                                <span class="app-wlk-day__summary-sep"></span>
                                                <span>A <strong>@tag.AnzahlGeplanteAerzte</strong></span>
                                            </div>
                                        }
                                        else if (tag.IstFeiertag)
                                        {
                                            <div class="app-wlk-day__hint app-wlk-day__hint--holiday">
                                                <i class="bi bi-stars"></i>
                                                @tag.FeiertagsName
                                            </div>
                                        }
                                        else if (tag.IstWochenende)
                                        {
                                            <div class="app-wlk-day__hint app-wlk-day__hint--weekend">Wochenende</div>
                                        }
                                        else
                                        {
                                            <div class="app-wlk-day__summary">
                                                <span>W <strong>@tag.AnzahlWuenscheGesamt</strong></span>
                                                <span class="app-wlk-day__summary-sep"></span>
                                                <span>NFS <strong>@tag.AnzahlGeplanteNotfallsanitaeter</strong></span>
                                                <span class="app-wlk-day__summary-sep"></span>
                                                <span>A <strong>@tag.AnzahlGeplanteAerzte</strong></span>
                                            </div>
                                        }
                                    </div>

                                    <div class="app-wlk-day__footer">
                                        <a asp-action="Wachleiterkalender"
                                           asp-controller="DienstplanWachleiter"
                                           asp-area="Intensivtransport"
                                           asp-route-periodeId="@Model.AusgewaehltePeriodeId"
                                           asp-route-planungsModal="true"
                                           asp-route-planJahr="@tag.Datum.Year"
                                           asp-route-planMonat="@tag.Datum.Month"
                                           asp-route-planTag="@tag.Datum.Day"
                                           class="app-btn app-btn-outline-accent app-btn-sm app-btn-block">
                                            <i class="bi bi-pencil-square"></i>
                                            Planen
                                        </a>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@* ── Tagesplanungs-Modal ── *@
@if (Model.PlanungsModal is not null)
{
    var modal     = Model.PlanungsModal;
    var arztSlot  = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Arzt);
    var nfs1Slot  = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Notfallsanitaeter1);
    var nfs2Slot  = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Notfallsanitaeter2);

    var finalModalFehler = !string.IsNullOrWhiteSpace(modalFehler)
        ? modalFehler
        : !modal.IsSuccess
            ? modal.ErrorMessage ?? "Die Daten für die Tagesplanung konnten nicht geladen werden."
            : null;

    <div class="modal fade"
         id="tagesplanungModal"
         tabindex="-1"
         aria-hidden="true"
         data-auto-open="@(Model.PlanungsModalAutomatischOeffnen ? "true" : "false")">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content app-wlk-modal">

                @* Header — Bootstrap modal-header keeps it fixed when body scrolls *@
                <div class="modal-header app-wlk-modal__header">
                    <div class="app-wlk-modal__icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="app-wlk-modal__meta">
                        <p class="app-wlk-modal__sub">@modal.PeriodeBezeichnung · @modal.DatumAnzeige</p>
                        <h2 class="app-wlk-modal__title">Tagesplanung bearbeiten</h2>
                    </div>
                    <button type="button" class="app-pm-modal__close" data-bs-dismiss="modal" aria-label="Schließen">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                @* Body — Bootstrap modal-body drives the scroll *@
                <div class="modal-body app-wlk-modal__body">

                @* Hidden form for Besetzung (inputs linked via form= attribute) *@
                <form id="besetzungForm"
                      asp-area="Intensivtransport"
                      asp-controller="DienstplanWachleiter"
                      asp-action="TagesplanungSpeichern"
                      method="post"
                      style="display:none"
                      data-app-loading-form
                      data-app-loading-text="Tagesplanung wird gespeichert...">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                    <input type="hidden" name="jahr"      value="@modal.Datum.Year" />
                    <input type="hidden" name="monat"     value="@modal.Datum.Month" />
                    <input type="hidden" name="tag"       value="@modal.Datum.Day" />
                    <input type="hidden" name="returnUrl" value="@modalReturnUrl" />
                </form>
                    @if (!string.IsNullOrWhiteSpace(finalModalFehler))
                    {
                        @await Html.PartialAsync(
                        "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                        finalModalFehler,
                        new ViewDataDictionary(ViewData)
                        {
                            ["Variant"] = "danger",
                            ["Title"] = "Fehler",
                            ["AutoHide"] = false
                        })
                    }

                    @if (modal.IsSuccess && modal.Tag.IstFeiertag)
                    {
                        @await Html.PartialAsync(
                        "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                        $"Sondereinsatz am Feiertag: {modal.Tag.FeiertagsName}",
                        new ViewDataDictionary(ViewData)
                        {
                            ["Variant"] = "info",
                            ["Title"] = "Sondereinsatz",
                            ["AutoHide"] = false,
                            ["IconClass"] = "bi bi-star-fill"
                        })
                    }
                    else if (modal.IsSuccess && modal.Tag.IstWochenende)
                    {
                        @await Html.PartialAsync(
                        "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                        "Dieser Sondereinsatz liegt an einem Wochenende und ist nur für Wachleiter und betroffene Mitarbeiter sichtbar.",
                        new ViewDataDictionary(ViewData)
                        {
                            ["Variant"] = "info",
                            ["Title"] = "Sondereinsatz – Wochenende",
                            ["AutoHide"] = false,
                            ["IconClass"] = "bi bi-star-fill"
                        })
                    }

                    @if (modal.IsSuccess)
                    {
                        <div class="app-wlk-modal__cols">

                            @* ── Linke Spalte: Verfügbar heute ── *@
                            <div class="app-wlk-wishes">
                                <p class="app-wlk-wishes__title">
                                    <i class="bi bi-people"></i>
                                    Verfügbar heute
                                </p>

                                @if (modal.WunschMitarbeiter.Count == 0)
                                {
                                    <div class="app-wlk-wishes__empty">
                                        <i class="bi bi-person-x"></i>
                                        Keine Mitarbeiter verfügbar
                                    </div>
                                }
                                else
                                {
                                    <div class="app-wlk-wish-list">
                                        @foreach (var mitarbeiter in modal.WunschMitarbeiter)
                                        {
                                            <div class="app-wlk-wish-item @(mitarbeiter.IstBereitsGeplant ? "app-wlk-wish-item--geplant" : "")">
                                                <div class="app-wlk-wish-item__info">
                                                    <span class="app-wlk-wish-item__name">@mitarbeiter.AnzeigeName</span>
                                                    <span class="app-wlk-qual @(mitarbeiter.Hauptqualifikation.Contains("Arzt", StringComparison.OrdinalIgnoreCase) ? "app-wlk-qual--arzt" : "app-wlk-qual--nfs")">
                                                        @mitarbeiter.Hauptqualifikation
                                                    </span>
                                                </div>
                                                <div class="app-wlk-wish-item__actions">
                                                    @if (mitarbeiter.IstBereitsGeplant)
                                                    {
                                                        <i class="bi bi-check2-circle app-wlk-wish-item__done" title="Bereits verplant"></i>
                                                    }
                                                    else
                                                    {
                                                        @if (mitarbeiter.KannAlsArztGeplantWerden)
                                                        {
                                                            <button type="button" form="besetzungForm"
                                                                    class="app-wlk-quick app-wlk-quick--arzt quick-assign-btn"
                                                                    data-target-select-id="arztUserId"
                                                                    data-user-id="@mitarbeiter.UserId">A</button>
                                                        }
                                                        @if (mitarbeiter.KannAlsNotfallsanitaeterGeplantWerden)
                                                        {
                                                            <button type="button" form="besetzungForm"
                                                                    class="app-wlk-quick app-wlk-quick--nfs quick-assign-btn"
                                                                    data-target-select-id="notfallsanitaeter1UserId"
                                                                    data-user-id="@mitarbeiter.UserId">N1</button>
                                                            <button type="button" form="besetzungForm"
                                                                    class="app-wlk-quick app-wlk-quick--nfs quick-assign-btn"
                                                                    data-target-select-id="notfallsanitaeter2UserId"
                                                                    data-user-id="@mitarbeiter.UserId">N2</button>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            @* ── Rechte Spalte: Slots (Zuweisung + Ausfall pro Slot) ── *@
                            <div class="app-wlk-slot-list">

                                @* Slot: Notarzt *@
                                <div class="app-wlk-slot2 app-wlk-slot2--arzt">
                                    <div class="app-wlk-slot2__top">
                                        <div class="app-wlk-slot2__meta">
                                            <span class="app-wlk-slot2__role">Notarzt</span>
                                            @if (arztSlot?.HatAusfall == true)
                                            {
                                                <span class="app-pill app-pill--warning">@arztSlot.StatusText</span>
                                            }
                                        </div>
                                        @if (arztSlot?.HatAusfall == true)
                                        {
                                            <input type="hidden" name="arztUserId" value="@modal.ArztUserId" form="besetzungForm" />
                                            <select id="arztUserId" class="app-pm-field__select" disabled="disabled">
                                                <option>@arztSlot.AktuelleBesetzungAnzeigeName</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select id="arztUserId" name="arztUserId" asp-items="modal.ArztOptionen"
                                                    class="app-pm-field__select" form="besetzungForm"></select>
                                        }
                                    </div>
                                    @* Ausfall-Form direkt im Slot *@
                                    <form asp-area="Intensivtransport"
                                          asp-controller="DienstplanWachleiter"
                                          asp-action="AusfallSpeichern"
                                          method="post"
                                          class="app-wlk-slot2__ausfall">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotCode"  value="@DienstbesetzungsSlotCode.Arzt" />
                                        <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                                        <input type="hidden" name="jahr"      value="@modal.Datum.Year" />
                                        <input type="hidden" name="monat"     value="@modal.Datum.Month" />
                                        <input type="hidden" name="tag"       value="@modal.Datum.Day" />
                                        <input type="hidden" name="returnUrl" value="@modalReturnUrl" />
                                        <select name="ausfallGrundCode" class="app-pm-field__select app-pm-field__select--sm">
                                            <option value="">Kein Ausfall</option>
                                            <option value="@DienstausfallGrundCode.Krankheit" selected="@(arztSlot?.AusfallGrundCode == DienstausfallGrundCode.Krankheit)">Krankheit</option>
                                            <option value="@DienstausfallGrundCode.Urlaub"    selected="@(arztSlot?.AusfallGrundCode == DienstausfallGrundCode.Urlaub)">Urlaub</option>
                                        </select>
                                        <select name="vertretungsUserId" asp-items="arztSlot?.VertretungsOptionen ?? new List<SelectListItem>()"
                                                class="app-pm-field__select app-pm-field__select--sm"></select>
                                        <button type="submit" class="app-btn app-btn-neutral app-btn-sm">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                </div>

                                @* Slot: NFS 1 *@
                                <div class="app-wlk-slot2 app-wlk-slot2--nfs">
                                    <div class="app-wlk-slot2__top">
                                        <div class="app-wlk-slot2__meta">
                                            <span class="app-wlk-slot2__role">NFS 1 – Transportführer</span>
                                            @if (nfs1Slot?.HatAusfall == true)
                                            {
                                                <span class="app-pill app-pill--warning">@nfs1Slot.StatusText</span>
                                            }
                                        </div>
                                        @if (nfs1Slot?.HatAusfall == true)
                                        {
                                            <input type="hidden" name="notfallsanitaeter1UserId" value="@modal.Notfallsanitaeter1UserId" form="besetzungForm" />
                                            <select id="notfallsanitaeter1UserId" class="app-pm-field__select" disabled="disabled">
                                                <option>@nfs1Slot.AktuelleBesetzungAnzeigeName</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select id="notfallsanitaeter1UserId" name="notfallsanitaeter1UserId"
                                                    class="app-pm-field__select" form="besetzungForm">
                                                @foreach (var o in modal.NotfallsanitaeterOptionen)
                                                {
                                                    if (string.Equals(o.Value, modal.Notfallsanitaeter1UserId, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <option value="@o.Value" selected="selected">@o.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@o.Value">@o.Text</option>
                                                    }
                                                }
                                            </select>
                                        }
                                    </div>
                                    <form asp-area="Intensivtransport"
                                          asp-controller="DienstplanWachleiter"
                                          asp-action="AusfallSpeichern"
                                          method="post"
                                          class="app-wlk-slot2__ausfall">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotCode"  value="@DienstbesetzungsSlotCode.Notfallsanitaeter1" />
                                        <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                                        <input type="hidden" name="jahr"      value="@modal.Datum.Year" />
                                        <input type="hidden" name="monat"     value="@modal.Datum.Month" />
                                        <input type="hidden" name="tag"       value="@modal.Datum.Day" />
                                        <input type="hidden" name="returnUrl" value="@modalReturnUrl" />
                                        <select name="ausfallGrundCode" class="app-pm-field__select app-pm-field__select--sm">
                                            <option value="">Kein Ausfall</option>
                                            <option value="@DienstausfallGrundCode.Krankheit" selected="@(nfs1Slot?.AusfallGrundCode == DienstausfallGrundCode.Krankheit)">Krankheit</option>
                                            <option value="@DienstausfallGrundCode.Urlaub"    selected="@(nfs1Slot?.AusfallGrundCode == DienstausfallGrundCode.Urlaub)">Urlaub</option>
                                        </select>
                                        <select name="vertretungsUserId" asp-items="nfs1Slot?.VertretungsOptionen ?? new List<SelectListItem>()"
                                                class="app-pm-field__select app-pm-field__select--sm"></select>
                                        <button type="submit" class="app-btn app-btn-neutral app-btn-sm">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                </div>

                                @* Slot: NFS 2 *@
                                <div class="app-wlk-slot2 app-wlk-slot2--nfs">
                                    <div class="app-wlk-slot2__top">
                                        <div class="app-wlk-slot2__meta">
                                            <span class="app-wlk-slot2__role">NFS 2 – Fahrer</span>
                                            @if (nfs2Slot?.HatAusfall == true)
                                            {
                                                <span class="app-pill app-pill--warning">@nfs2Slot.StatusText</span>
                                            }
                                        </div>
                                        @if (nfs2Slot?.HatAusfall == true)
                                        {
                                            <input type="hidden" name="notfallsanitaeter2UserId" value="@modal.Notfallsanitaeter2UserId" form="besetzungForm" />
                                            <select id="notfallsanitaeter2UserId" class="app-pm-field__select" disabled="disabled">
                                                <option>@nfs2Slot.AktuelleBesetzungAnzeigeName</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select id="notfallsanitaeter2UserId" name="notfallsanitaeter2UserId"
                                                    class="app-pm-field__select" form="besetzungForm">
                                                @foreach (var o in modal.NotfallsanitaeterOptionen)
                                                {
                                                    if (string.Equals(o.Value, modal.Notfallsanitaeter2UserId, StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <option value="@o.Value" selected="selected">@o.Text</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@o.Value">@o.Text</option>
                                                    }
                                                }
                                            </select>
                                        }
                                    </div>
                                    <form asp-area="Intensivtransport"
                                          asp-controller="DienstplanWachleiter"
                                          asp-action="AusfallSpeichern"
                                          method="post"
                                          class="app-wlk-slot2__ausfall">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotCode"  value="@DienstbesetzungsSlotCode.Notfallsanitaeter2" />
                                        <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                                        <input type="hidden" name="jahr"      value="@modal.Datum.Year" />
                                        <input type="hidden" name="monat"     value="@modal.Datum.Month" />
                                        <input type="hidden" name="tag"       value="@modal.Datum.Day" />
                                        <input type="hidden" name="returnUrl" value="@modalReturnUrl" />
                                        <select name="ausfallGrundCode" class="app-pm-field__select app-pm-field__select--sm">
                                            <option value="">Kein Ausfall</option>
                                            <option value="@DienstausfallGrundCode.Krankheit" selected="@(nfs2Slot?.AusfallGrundCode == DienstausfallGrundCode.Krankheit)">Krankheit</option>
                                            <option value="@DienstausfallGrundCode.Urlaub"    selected="@(nfs2Slot?.AusfallGrundCode == DienstausfallGrundCode.Urlaub)">Urlaub</option>
                                        </select>
                                        <select name="vertretungsUserId" asp-items="nfs2Slot?.VertretungsOptionen ?? new List<SelectListItem>()"
                                                class="app-pm-field__select app-pm-field__select--sm"></select>
                                        <button type="submit" class="app-btn app-btn-neutral app-btn-sm">
                                            <i class="bi bi-check2"></i>
                                        </button>
                                    </form>
                                </div>

                            </div>
                        </div>
                    }

                </div>

                @* ── Modal footer: Besetzung speichern ── *@
                @if (modal.IsSuccess)
                {
                    <div class="modal-footer app-wlk-modal__footer">
                        <button type="submit" form="besetzungForm" class="app-btn app-btn-primary">
                            <i class="bi bi-check2-all"></i>
                            Besetzung speichern
                        </button>
                        <button type="submit" form="besetzungForm" name="planungLeeren" value="true"
                                class="app-btn app-btn-neutral app-btn-sm">
                            Leeren
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/app-wachleiter-kalender.js" asp-append-version="true"></script>
}
