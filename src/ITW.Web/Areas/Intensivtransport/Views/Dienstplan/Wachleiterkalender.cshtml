@using ITW.Dienstplan.Domain.Enums
@model ITW.Web.Areas.Intensivtransport.ViewModels.Dienstplan.WachleiterWunschkalenderViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Wachleiterkalender";

    var returnUrl = Url.Action("Wachleiterkalender", "Dienstplan", new
    {
        area = "Intensivtransport",
        periodeId = Model.AusgewaehltePeriodeId
    }) ?? string.Empty;

    var modalReturnUrl = Model.PlanungsModal?.ReturnUrl ?? returnUrl;

    var successMessage = TempData[FlashKeys.Success] as string;
    var errorMessage = TempData[FlashKeys.Error] as string;

    var zeigeSeitenErfolg = !Model.PlanungsModalAutomatischOeffnen && !string.IsNullOrWhiteSpace(successMessage);
    var zeigeSeitenFehler = !Model.PlanungsModalAutomatischOeffnen && !string.IsNullOrWhiteSpace(errorMessage);
    var zeigeModalFehler = Model.PlanungsModalAutomatischOeffnen && !string.IsNullOrWhiteSpace(errorMessage);

    var finalSeitenFehler = zeigeSeitenFehler || !Model.IsSuccess
        ? errorMessage ?? Model.ErrorMessage ?? "Ein Fehler ist aufgetreten."
        : null;
}

<div class="wl-page">
    <div class="wl-page-hero mb-4">
        <div class="wl-page-hero__content">
            <div class="wl-page-label">
                <i class="bi bi-kanban"></i>
                Wachleiter
            </div>

            <h1 class="wl-page-title">@Model.Titel</h1>
            <p class="wl-page-text">@Model.Beschreibung</p>
        </div>

        <a 
           asp-controller="Dienstplan"
           asp-action="Index"
           class="btn wl-btn-white border shadow-sm fw-bold text-muted px-4 wl-transition-all wl-hover-translate-back wl-back-button">
            <i class="bi bi-arrow-left me-2 text-primary"></i>Zurück zur Übersicht
        </a>
    </div>

    @if (zeigeSeitenErfolg || !string.IsNullOrWhiteSpace(finalSeitenFehler))
    {
        <div class="app-status-stack mb-4">
            @if (zeigeSeitenErfolg)
            {
                @await Html.PartialAsync(
                "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                successMessage,
                new ViewDataDictionary(ViewData)
                {
                    ["Variant"] = "success",
                    ["Title"] = "Erfolgreich gespeichert",
                    ["AutoHide"] = true,
                    ["AutoHideMilliseconds"] = 3000
                })
                }

            @if (!string.IsNullOrWhiteSpace(finalSeitenFehler))
            {
                @await Html.PartialAsync(
                "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                finalSeitenFehler,
                new ViewDataDictionary(ViewData)
                {
                    ["Variant"] = "danger",
                    ["Title"] = "System-Hinweis",
                    ["AutoHide"] = false
                })
                }
        </div>
    }

    @if (Model.AusgewaehltePeriodeId.HasValue)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden border-start border-4 border-primary wl-control-card">
            <div class="card-body p-3 px-4">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-lg-3 wl-border-end-lg wl-control-block">
                        <div class="wl-control-eyebrow">Aktive Ansicht</div>
                        <div class="wl-control-heading">@Model.AusgewaehltePeriodeBezeichnung</div>
                        <p class="wl-control-copy">
                            Wunschabgabe, Tagesplanung und Freigabestatus für die aktuell ausgewählte Periode.
                        </p>
                    </div>

                    <div class="col-12 col-md-5 col-lg-3 wl-border-end-lg px-lg-4 wl-control-block">
                        <form asp-area="Intensivtransport"
                          asp-controller="DienstplanWachleiter"
                          asp-action="Wachleiterkalender" class="d-flex align-items-end gap-2 wl-control-form">
                            <div class="flex-grow-1">
                                <label class="wl-text-xs fw-bold text-muted text-uppercase mb-1 ms-1">Zeitraum wechseln</label>
                                <div class="input-group input-group-sm border rounded-3 bg-light overflow-hidden">
                                    <span class="input-group-text border-0 bg-transparent ps-3">
                                        <i class="bi bi-calendar3 text-muted"></i>
                                    </span>
                                    <select name="periodeId"
                                            asp-items="Model.PeriodenOptionen"
                                            class="form-select border-0 bg-transparent shadow-none fw-bold text-dark"></select>
                                </div>
                            </div>

                            <button type="submit" class="app-btn app-btn-neutral app-btn-sm">
                                Laden
                            </button>
                        </form>
                    </div>

                    <div class="col-12 col-md-7 col-lg-6 ps-lg-4 wl-control-block">
                        <div class="wl-control-status">
                            <div class="wl-control-status-row">
                                <span class="wl-badge @(Model.WunschphaseIstOffen ? "wl-badge-success" : "wl-badge-light border")">
                                    @if (Model.WunschphaseIstOffen)
                                    {
                                        <span class="wl-pulse-dot me-2"></span>
                                    }
                                    <i class="bi @(Model.WunschphaseIstOffen ? "bi-unlock-fill" : "bi-lock-fill") me-2"></i>
                                    @(Model.WunschphaseIstOffen ? "Wunschphase" : "Geschlossen")
                                </span>

                                <span class="wl-badge @(Model.PlanIstFreigegeben ? "wl-badge-primary" : "wl-badge-light border")">
                                    <i class="bi @(Model.PlanIstFreigegeben ? "bi-eye-fill" : "bi-eye-slash-fill") me-2"></i>
                                    @(Model.PlanIstFreigegeben ? "Freigegeben" : "Entwurf")
                                </span>
                            </div>

                            <div class="wl-control-actions">
                                <form asp-area="Intensivtransport"
                                      asp-controller="DienstplanWachleiter"
                                      asp-action="WunschphaseStatusAendern"
                                      method="post"
                                      data-app-loading-form
                                      data-app-loading-text="Wunschphase wird aktualisiert..."
                                      class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="periodeId" value="@Model.AusgewaehltePeriodeId" />
                                    <input type="hidden" name="oeffnen" value="@(Model.WunschphaseIstOffen ? "false" : "true")" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="app-btn app-btn-sm @(Model.WunschphaseIstOffen ? "app-btn-neutral" : "app-btn-accent") fw-bold">
                                        @(Model.WunschphaseIstOffen ? "Phase beenden" : "Wunschphase öffnen")
                                    </button>
                                </form>

                                @if (!Model.WunschphaseIstOffen)
                                {
                                    <form asp-area="Intensivtransport"
                                          asp-controller="DienstplanWachleiter"
                                          asp-action="PlanFreigabeAendern"
                                          method="post"
                                          data-app-loading-form
                                          data-app-loading-text="Planfreigabe wird aktualisiert..."
                                          class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="periodeId" value="@Model.AusgewaehltePeriodeId" />
                                        <input type="hidden" name="freigeben" value="@(Model.PlanIstFreigegeben ? "false" : "true")" />
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="app-btn app-btn-sm @(Model.PlanIstFreigegeben ? "app-btn-neutral" : "app-btn-success wl-shadow-success") fw-bold">
                                            @(Model.PlanIstFreigegeben ? "Freigabe entfernen" : "Veröffentlichen")
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="fw-bold mb-0 text-dark">@Model.AusgewaehltePeriodeBezeichnung</h5>
            </div>

            <div class="card-body p-4 pt-3">
                <div class="dienstplan-kalender-wrapper">
                    <div class="dienstplan-kalender-head mb-2 text-muted fw-bold text-uppercase small">
                        <div>Mo</div><div>Di</div><div>Mi</div><div>Do</div><div>Fr</div><div class="text-danger">Sa</div><div class="text-danger">So</div>
                    </div>

                    <div class="dienstplan-kalender-grid">
                        @foreach (var woche in Model.KalenderWochen)
                        {
                            foreach (var tag in woche.Tage)
                            {
                                var isInactive = !tag.IstImAktivenMonat;
                                var statusCss = !isInactive && !tag.IstFeiertag && !tag.IstWochenende
                                ? tag.WachleiterStatusCssClass
                                : string.Empty;

                                <div class="kalender-tag @(isInactive ? "leer" : "aktiv") @(tag.IstHeute ? "heute" : "") @(tag.IstWochenende ? "wochenende" : "") @statusCss">
                                    <div class="tag-header d-flex justify-content-between align-items-start">
                                        <span class="tag-number">@tag.Datum.Day</span>

                                        @if (!isInactive && !tag.IstFeiertag && !tag.IstWochenende)
                                        {
                                            <span class="tag-status @tag.WachleiterStatusCssClass">@tag.WachleiterStatusText</span>
                                        }
                                    </div>

                                    @if (!isInactive)
                                    {
                                        <div class="tag-content mt-auto">
                                            @if (tag.IstFeiertag)
                                            {
                                                <div class="hinweis-badge feiertag">
                                                    <i class="bi bi-stars me-1"></i>@tag.FeiertagsName
                                                </div>
                                            }
                                            else if (tag.IstWochenende)
                                            {
                                                <div class="hinweis-badge wochenende">Wochenende</div>
                                            }
                                            else
                                            {
                                                <div class="staff-combined-badge @tag.WachleiterStatusCssClass">
                                                    <span class="segment">W <strong class="ms-1">@tag.AnzahlWuenscheGesamt</strong></span>
                                                    <span class="divider"></span>
                                                    <span class="segment">NFS <strong class="ms-1">@tag.AnzahlGeplanteNotfallsanitaeter</strong></span>
                                                    <span class="divider"></span>
                                                    <span class="segment">A <strong class="ms-1">@tag.AnzahlGeplanteAerzte</strong></span>
                                                </div>
                                            }
                                        </div>

                                        <div class="tag-footer">
                                            <a asp-action="Wachleiterkalender"
                                               asp-route-periodeId="@Model.AusgewaehltePeriodeId"
                                               asp-route-planungsModal="true"
                                               asp-route-planJahr="@tag.Datum.Year"
                                               asp-route-planMonat="@tag.Datum.Month"
                                               asp-route-planTag="@tag.Datum.Day"
                                               class="app-btn app-btn-outline-accent app-btn-sm app-btn-block fw-bold">
                                                <i class="bi bi-pencil-square me-1"></i>Planen
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@if (Model.PlanungsModal is not null)
{
    var modal = Model.PlanungsModal;
    var arztSlot = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Arzt);
    var nfs1Slot = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Notfallsanitaeter1);
    var nfs2Slot = modal.PlanungsSlots.FirstOrDefault(x => x.SlotCode == DienstbesetzungsSlotCode.Notfallsanitaeter2);

    var finalModalFehler = zeigeModalFehler
        ? errorMessage
        : !modal.IsSuccess
            ? modal.ErrorMessage ?? "Die Daten für die Tagesplanung konnten nicht geladen werden."
            : null;

    <div class="modal fade wl-modal"
         id="tagesplanungModal"
         tabindex="-1"
         aria-hidden="true"
         data-auto-open="@(Model.PlanungsModalAutomatischOeffnen ? "true" : "false")">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg bg-light rounded-4 overflow-hidden">

                <div class="modal-header bg-white border-0 pb-0 pt-4 px-4">
                    <div class="d-flex align-items-center">
                        <div class="wl-modal-icon bg-primary-subtle text-primary me-3">
                            <i class="bi bi-calendar-check fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Tagesplanung bearbeiten</h5>
                            <span class="text-muted small">@modal.PeriodeBezeichnung · @modal.DatumAnzeige</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(finalModalFehler))
                    {
                        <div class="app-status-stack mb-3">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                                        finalModalFehler,
                                        new ViewDataDictionary(ViewData)
                                        {
                                            ["Variant"] = "danger",
                                            ["Title"] = "Fehler bei der Tagesplanung",
                                            ["AutoHide"] = false
                                        })
                </div>
                                }

                    @if (modal.IsSuccess && modal.Tag.IstFeiertag)
                    {
                        <div class="app-status-stack mb-0">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                                        modal.Tag.FeiertagsName,
                                        new ViewDataDictionary(ViewData)
                                        {
                                            ["Variant"] = "warning",
                                            ["Title"] = "Keine Tagesplanung möglich",
                                            ["AutoHide"] = false,
                                            ["IconClass"] = "bi bi-stars"
                                        })
                </div>
                                }
                    else if (modal.IsSuccess && modal.Tag.IstWochenende)
                    {
                        <div class="app-status-stack mb-0">
                            @await Html.PartialAsync(
                            "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                                        "Wochenende",
                                        new ViewDataDictionary(ViewData)
                                        {
                                            ["Variant"] = "warning",
                                            ["Title"] = "Keine Tagesplanung möglich",
                                            ["AutoHide"] = false,
                                            ["IconClass"] = "bi bi-calendar-week"
                                        })
                </div>
                                }
                    else if (modal.IsSuccess)
                    {
                        <div class="row g-4">
                            <div class="col-12 col-xl-4">
                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                                        <h6 class="fw-bold text-uppercase small text-muted wl-tracking-wide">Verfügbarkeit / Wünsche</h6>
                                    </div>
                                    <div class="card-body p-4 pt-2">
                                        @if (modal.WunschMitarbeiter.Count == 0)
                                        {
                                            <div class="text-center py-5 text-muted opacity-50">
                                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                                <small>Keine Mitarbeiter für diesen Tag</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="wunschliste-container">
                                                @foreach (var mitarbeiter in modal.WunschMitarbeiter)
                                                {
                                                    <div class="wunsch-item p-3 mb-2 rounded-3 border bg-white @(mitarbeiter.IstBereitsGeplant ? "opacity-50" : "shadow-sm")">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <div class="pe-2">
                                                                <div class="fw-bold text-dark small">@mitarbeiter.AnzeigeName</div>
                                                                <div class="wl-qualification-tag @(mitarbeiter.Hauptqualifikation.Contains("Arzt", StringComparison.OrdinalIgnoreCase) ? "wl-qualification-arzt" : "wl-qualification-nfs")">
                                                                    @mitarbeiter.Hauptqualifikation
                                                                </div>
                                                            </div>
                                                            @if (mitarbeiter.IstBereitsGeplant)
                                                            {
                                                                <i class="bi bi-person-check-fill text-success" title="Bereits verplant"></i>
                                                            }
                                                        </div>

                                                        <div class="mt-3 d-flex flex-wrap gap-1">
                                                            @if (mitarbeiter.KannAlsArztGeplantWerden)
                                                            {
                                                                <button type="button" class="btn wl-btn-xs btn-outline-danger quick-assign-btn" data-target-select-id="arztUserId" data-user-id="@mitarbeiter.UserId">Setze Arzt</button>
                                                            }
                                                            @if (mitarbeiter.KannAlsNotfallsanitaeterGeplantWerden)
                                                            {
                                                                <button type="button" class="btn wl-btn-xs btn-outline-primary quick-assign-btn" data-target-select-id="notfallsanitaeter1UserId" data-user-id="@mitarbeiter.UserId">NFS 1</button>
                                                                <button type="button" class="btn wl-btn-xs btn-outline-primary quick-assign-btn" data-target-select-id="notfallsanitaeter2UserId" data-user-id="@mitarbeiter.UserId">NFS 2</button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-xl-8">
                                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-start border-4 border-primary">
                                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                                        <h6 class="fw-bold mb-0 text-primary">1. Grundbesetzung (Soll)</h6>
                                        <div class="d-flex gap-2">
                                            <span class="badge @(modal.Tag.AnzahlGeplanteAerzte >= 1 ? "bg-danger" : "bg-light text-muted") rounded-pill">
                                                Notarzt: @modal.Tag.AnzahlGeplanteAerzte/1
                                            </span>
                                            <span class="badge @(modal.Tag.AnzahlGeplanteNotfallsanitaeter >= 2 ? "bg-primary" : "bg-light text-muted") rounded-pill">
                                                NFS: @modal.Tag.AnzahlGeplanteNotfallsanitaeter/2
                                            </span>
                                        </div>
                                    </div>

                                    <div class="card-body p-4">
                                        @if ((arztSlot?.HatAusfall ?? false) || (nfs1Slot?.HatAusfall ?? false) || (nfs2Slot?.HatAusfall ?? false))
                                        {
                                            <div class="app-status-stack mb-4">
                                                @await Html.PartialAsync(
                                                "~/Views/Shared/Komponenten/_AppStatusMessage.cshtml",
                                                                        "Einzelne Slots werden für diesen Tag bereits über Ausfall & Vertretung geführt. Diese Slots sind hier oben gesperrt und müssen unten im Ausfallbereich geändert werden. Nicht betroffene Slots kannst du weiterhin ganz normal in der Grundbesetzung anpassen.",
                                                                        new ViewDataDictionary(ViewData)
                                                                        {
                                                                            ["Variant"] = "warning",
                                                                            ["Title"] = "Hinweis zur Grundbesetzung",
                                                                            ["AutoHide"] = false
                                                                        })
                                </div>
                                                                }

                                        <form asp-area="Intensivtransport"
                                              asp-controller="DienstplanWachleiter"
                                              asp-action="TagesplanungSpeichern"
                                              method="post"
                                              class="app-modal__form"
                                              data-app-loading-form
                                              data-app-loading-text="Tagesplanung wird gespeichert...">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                                            <input type="hidden" name="jahr" value="@modal.Datum.Year" />
                                            <input type="hidden" name="monat" value="@modal.Datum.Month" />
                                            <input type="hidden" name="tag" value="@modal.Datum.Day" />
                                            <input type="hidden" name="returnUrl" value="@modalReturnUrl" />

                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <div class="slot-selection-card wl-slot-arzt p-3 rounded-3 border">
                                                        <div class="row align-items-start">
                                                            <div class="col-md-4">
                                                                <span class="slot-label text-danger">Zugeordneter Notarzt</span>
                                                                <div class="fw-bold fs-5">@(arztSlot?.AktuelleBesetzungAnzeigeName ?? "Offen")</div>

                                                                @if (arztSlot?.HatAusfall == true)
                                                                {
                                                                    <div class="mt-2">
                                                                        <span class="badge bg-warning text-dark">@arztSlot.StatusText</span>
                                                                    </div>
                                                                    <div class="small text-muted mt-2">
                                                                        Ursprünglich geplant: <strong>@arztSlot.UrspruenglichGeplanteAnzeigeName</strong><br />
                                                                        Dieser Slot wird aktuell über <strong>Ausfall &amp; Vertretung</strong> geführt und ist hier gesperrt.
                                                                    </div>
                                                                }
                                                                else if (!string.IsNullOrWhiteSpace(arztSlot?.AktuelleBesetzungQualifikation))
                                                                {
                                                                    <div class="small text-muted mt-2">@arztSlot.AktuelleBesetzungQualifikation</div>
                                                                }
                                                            </div>

                                                            <div class="col-md-8">
                                                                @if (arztSlot?.HatAusfall == true)
                                                                {
                                                                    <input type="hidden" name="arztUserId" value="@modal.ArztUserId" />
                                                                    <select id="arztUserId"
                                                                            class="form-select border-0 shadow-sm"
                                                                            disabled="disabled">
                                                                        <option>@(arztSlot.AktuelleBesetzungAnzeigeName)</option>
                                                                    </select>
                                                                }
                                                                else
                                                                {
                                                                    <select id="arztUserId"
                                                                            name="arztUserId"
                                                                            asp-items="modal.ArztOptionen"
                                                                            class="form-select border-0 shadow-sm"></select>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="slot-selection-card wl-slot-nfs p-3 rounded-3 border">
                                                        <span class="slot-label text-primary">NFS 1 (Transportführer)</span>

                                                        <div class="fw-bold mt-1 mb-2">@(nfs1Slot?.AktuelleBesetzungAnzeigeName ?? "Offen")</div>

                                                        @if (nfs1Slot?.HatAusfall == true)
                                                        {
                                                            <div class="mb-2">
                                                                <span class="badge bg-warning text-dark">@nfs1Slot.StatusText</span>
                                                            </div>
                                                            <div class="small text-muted mb-3">
                                                                Ursprünglich geplant: <strong>@nfs1Slot.UrspruenglichGeplanteAnzeigeName</strong><br />
                                                                Dieser Slot wird aktuell über <strong>Ausfall &amp; Vertretung</strong> geführt und ist hier gesperrt.
                                                            </div>

                                                            <input type="hidden" name="notfallsanitaeter1UserId" value="@modal.Notfallsanitaeter1UserId" />
                                                            <select id="notfallsanitaeter1UserId" class="form-select border-0 shadow-sm" disabled="disabled">
                                                                <option>@(nfs1Slot.AktuelleBesetzungAnzeigeName)</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <select id="notfallsanitaeter1UserId" name="notfallsanitaeter1UserId" class="form-select border-0 shadow-sm">
                                                                @foreach (var o in modal.NotfallsanitaeterOptionen)
                                                                {
                                                                    if (string.Equals(o.Value, modal.Notfallsanitaeter1UserId, StringComparison.OrdinalIgnoreCase))
                                                                    {
                                                                        <option value="@o.Value" selected="selected">@o.Text</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@o.Value">@o.Text</option>
                                                                    }
                                                                }
                                                            </select>
                                                        }
                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="slot-selection-card wl-slot-nfs p-3 rounded-3 border">
                                                        <span class="slot-label text-primary">NFS 2 (Fahrer)</span>

                                                        <div class="fw-bold mt-1 mb-2">@(nfs2Slot?.AktuelleBesetzungAnzeigeName ?? "Offen")</div>

                                                        @if (nfs2Slot?.HatAusfall == true)
                                                        {
                                                            <div class="mb-2">
                                                                <span class="badge bg-warning text-dark">@nfs2Slot.StatusText</span>
                                                            </div>
                                                            <div class="small text-muted mb-3">
                                                                Ursprünglich geplant: <strong>@nfs2Slot.UrspruenglichGeplanteAnzeigeName</strong><br />
                                                                Dieser Slot wird aktuell über <strong>Ausfall &amp; Vertretung</strong> geführt und ist hier gesperrt.
                                                            </div>

                                                            <input type="hidden" name="notfallsanitaeter2UserId" value="@modal.Notfallsanitaeter2UserId" />
                                                            <select id="notfallsanitaeter2UserId" class="form-select border-0 shadow-sm" disabled="disabled">
                                                                <option>@(nfs2Slot.AktuelleBesetzungAnzeigeName)</option>
                                                            </select>
                                                        }
                                                        else
                                                        {
                                                            <select id="notfallsanitaeter2UserId" name="notfallsanitaeter2UserId" class="form-select border-0 shadow-sm">
                                                                @foreach (var o in modal.NotfallsanitaeterOptionen)
                                                                {
                                                                    if (string.Equals(o.Value, modal.Notfallsanitaeter2UserId, StringComparison.OrdinalIgnoreCase))
                                                                    {
                                                                        <option value="@o.Value" selected="selected">@o.Text</option>
                                                                    }
                                                                    else
                                                                    {
                                                                        <option value="@o.Value">@o.Text</option>
                                                                    }
                                                                }
                                                            </select>
                                                        }
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="mt-4 pt-3 border-top d-flex gap-2">
                                                <button type="submit" class="app-btn app-btn-accent fw-bold">Besetzung speichern</button>
                                                <button type="submit" name="planungLeeren" value="true" class="app-btn app-btn-neutral app-btn-sm">Leeren</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-warning">
                                    <div class="card-header bg-white border-bottom py-3 px-4">
                                        <h6 class="fw-bold mb-0 text-warning-emphasis small text-uppercase">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>2. Ausfall &amp; Vertretung
                                        </h6>
                                    </div>

                                    <div class="card-body p-4">
                                        <div class="accordion accordion-flush" id="ausfallAccordion">
                                            @foreach (var slot in modal.PlanungsSlots)
                                            {
                                                var collapseId = $"collapse_{slot.SlotCode}";
                                                <div class="accordion-item mb-2 border rounded-3 overflow-hidden shadow-none">
                                                    <h2 class="accordion-header">
                                                        <button class="accordion-button @(slot.HatAusfall ? "" : "collapsed") py-2 small fw-bold shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                                            @slot.SlotBezeichnung: @(slot.HatAusfall? slot.UrspruenglichGeplanteAnzeigeName: slot.AktuelleBesetzungAnzeigeName)
                                                            @if (slot.HatAusfall)
                                                            {
                                                                <span class="badge bg-warning text-dark ms-2">@slot.StatusText</span>
                                                            }
                                                        </button>
                                                    </h2>
                                                    <div id="@collapseId" class="accordion-collapse collapse @(slot.HatAusfall ? "show" : "")" data-bs-parent="#ausfallAccordion">
                                                        <div class="accordion-body wl-surface-muted">
                                                            <form asp-area="Intensivtransport"
                                                                  asp-controller="DienstplanWachleiter"
                                                                  asp-action="AusfallSpeichern" 
                                                                  method="post" class="row g-2 align-items-end">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="slotCode" value="@slot.SlotCode" />
                                                                <input type="hidden" name="periodeId" value="@modal.PeriodeId" />
                                                                <input type="hidden" name="jahr" value="@modal.Datum.Year" />
                                                                <input type="hidden" name="monat" value="@modal.Datum.Month" />
                                                                <input type="hidden" name="tag" value="@modal.Datum.Day" />
                                                                <input type="hidden" name="returnUrl" value="@modalReturnUrl" />

                                                                <div class="col-md-5">
                                                                    <label class="wl-text-xs fw-bold text-muted">Ausfallgrund</label>
                                                                    <select name="ausfallGrundCode" class="form-select form-select-sm shadow-none border-light-subtle">
                                                                        <option value="">-- Kein Ausfall --</option>
                                                                        <option value="@DienstausfallGrundCode.Krankheit" selected="@(slot.AusfallGrundCode == DienstausfallGrundCode.Krankheit)">Krankheit</option>
                                                                        <option value="@DienstausfallGrundCode.Urlaub" selected="@(slot.AusfallGrundCode == DienstausfallGrundCode.Urlaub)">Urlaub</option>
                                                                    </select>
                                                                </div>
                                                                <div class="col-md-5">
                                                                    <label class="wl-text-xs fw-bold text-muted">Vertretung</label>
                                                                    <select name="vertretungsUserId" asp-items="slot.VertretungsOptionen" class="form-select form-select-sm shadow-none border-light-subtle"></select>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <button type="submit" class="app-btn app-btn-neutral app-btn-sm app-btn-block fw-bold">OK</button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/app-wachleiter-kalender.js" asp-append-version="true"></script>
}