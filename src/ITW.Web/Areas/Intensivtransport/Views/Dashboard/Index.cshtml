@model ITW.Web.Areas.Intensivtransport.ViewModels.ItwDashboardViewModel

@{
    ViewData["Title"] = "Startseite";
}

<div class="app-dashboard-page">
    <div class="app-dashboard-header">
        <div class="app-dashboard-header__content">
            <h1 class="app-dashboard-header__title">Bereich Intensivtransport</h1>
        </div>

        @if (Model.IstWachleiter)
        {
            <div class="app-dashboard-header__badge">
                <i class="bi bi-shield-check"></i>
                Wachleiter
            </div>
        }
        else if (Model.IstMitarbeiter)
        {
            <div class="app-dashboard-header__badge">
                <i class="bi bi-person-badge"></i>
                Mitarbeiter
            </div>
        }
    </div>

    @if (Model.IstWachleiter)
    {
        <div class="app-wl-grid">

            @* Offene Aufgaben *@
            <div class="app-surface">
                <div class="app-card-hd">
                    <span class="app-card-hd__label">
                        <i class="bi bi-check2-square"></i>
                        Offene Aufgaben
                    </span>
                    @if (Model.OffeneAufgaben.Count > 0)
                    {
                        <span class="app-card-hd__meta">@Model.OffeneAufgaben.Count offen</span>
                    }
                </div>

                @if (Model.OffeneAufgaben.Count == 0)
                {
                    <div style="padding: var(--sp-pad); color: var(--outline); font-size: var(--type-body-sm-size); text-align: center;">
                        <i class="bi bi-check2-all" style="font-size: 1.5rem; display: block; margin-bottom: .5rem;"></i>
                        Keine offenen Aufgaben.
                    </div>
                }
                else
                {
                    <ul class="app-task-list">
                        @foreach (var aufgabe in Model.OffeneAufgaben)
                        {
                            <li class="app-task-item @(aufgabe.IstUeberfaellig ? "app-task-item--ueberfaellig" : "")">
                                <form asp-action="AufgabeErledigen" asp-controller="Dashboard" asp-area="Intensivtransport"
                                      method="post" class="app-task-item__check-form">
                                    <input type="hidden" name="aufgabeId" value="@aufgabe.Id" />
                                    <button type="submit" class="app-task-item__check" title="Als erledigt markieren"
                                            aria-label="Aufgabe erledigen">
                                        <i class="bi bi-circle"></i>
                                    </button>
                                </form>
                                <div class="app-task-item__body">
                                    <span class="app-task-item__titel">@aufgabe.Titel</span>
                                    <div class="app-task-item__meta">
                                        @if (aufgabe.FaelligkeitAnzeige is not null)
                                        {
                                            <span class="app-task-item__faelligkeit @(aufgabe.IstUeberfaellig ? "app-task-item__faelligkeit--warn" : "")">
                                                <i class="bi bi-clock"></i>
                                                @aufgabe.FaelligkeitAnzeige
                                            </span>
                                        }
                                        @if (aufgabe.IstSystem)
                                        {
                                            <span class="app-task-item__badge">System</span>
                                        }
                                        @if (aufgabe.PrioritaetKlasse != "normal")
                                        {
                                            <span class="app-task-item__prio app-task-item__prio--@aufgabe.PrioritaetKlasse">
                                                @(aufgabe.PrioritaetKlasse == "dringend" ? "Dringend" : "Hoch")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }

                @* Neue Aufgabe erstellen *@
                <div class="app-task-new">
                    <form asp-action="AufgabeErstellen" asp-controller="Dashboard" asp-area="Intensivtransport"
                          method="post" class="app-task-new__form" id="task-new-form">
                        <input type="text" name="titel" class="app-task-new__input"
                               placeholder="Neue Aufgabe hinzufügen…"
                               maxlength="200"
                               autocomplete="off" />
                        <select name="prioritaet" class="app-task-new__prio" title="Priorität">
                            <option value="0">Normal</option>
                            <option value="1">Hoch</option>
                            <option value="2">Dringend</option>
                        </select>
                        <input type="date" name="faelligkeitsdatum" class="app-task-new__date" title="Fälligkeitsdatum (optional)" />
                        <button type="submit" class="app-btn app-btn-primary app-btn-sm">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </form>
                </div>
            </div>

            @* Rechte Spalte *@
            <div class="app-wl-col">

                @* Letzte Aktivitäten *@
                <div class="app-surface">
                    <div class="app-card-hd">
                        <span class="app-card-hd__label">
                            <i class="bi bi-clock-history"></i>
                            Letzte Aktivitäten
                        </span>
                    </div>

                    @if (Model.LetzteAktivitaeten.Count == 0)
                    {
                        <div style="padding: var(--sp-pad); color: var(--outline); font-size: var(--type-body-sm-size); text-align: center;">
                            <i class="bi bi-inbox" style="font-size: 1.5rem; display: block; margin-bottom: .5rem;"></i>
                            Noch keine Aktivitäten vorhanden.
                        </div>
                    }
                    else
                    {
                        @foreach (var a in Model.LetzteAktivitaeten)
                        {
                            <div class="app-wl-activity">
                                <div class="app-wl-activity__icon app-wl-activity__icon--@a.Kategorie">
                                    <i class="@a.IconCssClass"></i>
                                </div>
                                <div>
                                    <p class="app-wl-activity__text">@Html.Raw(a.Text)</p>
                                    <span class="app-wl-activity__time">@a.ZeitpunktAnzeige</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Dienstwünsche *@
                @if (Model.AktuelleWunschphase is not null)
                {
                    var wp = Model.AktuelleWunschphase;
                    <div class="app-surface">
                        <div class="app-card-hd">
                            <span class="app-card-hd__label">
                                <i class="bi bi-calendar-range"></i>
                                Dienstwünsche @wp.Bezeichnung
                            </span>
                            <span class="app-card-hd__meta">@wp.EingegangeneWuensche / @wp.GesamtMitarbeiter</span>
                        </div>

                        <div class="app-wl-progress-wrap">
                            <div class="app-wl-progress">
                                <div class="app-wl-progress__fill" style="width: @wp.ProzentEingegangen%;"></div>
                            </div>
                            <div class="app-wl-progress-info">
                                <span><strong>@wp.EingegangeneWuensche</strong> eingegangen</span>
                                @if (wp.WeitereAusstehend + (wp.GesamtMitarbeiter - wp.EingegangeneWuensche) > 0)
                                {
                                    <span class="app-wl-progress-info__warn">
                                        @(wp.GesamtMitarbeiter - wp.EingegangeneWuensche) ausstehend
                                    </span>
                                }
                            </div>
                        </div>

                        @if (wp.AngezeigtePersonen.Count > 0)
                        {
                            <div class="app-wl-wish-grid">
                                @foreach (var p in wp.AngezeigtePersonen)
                                {
                                    <div class="app-wl-wish-person @(p.HatWunschAbgegeben ? "app-wl-wish-person--done" : "")">
                                        <div class="app-wl-wish-person__avatar">@p.Kuerzel</div>
                                        <div>
                                            <div class="app-wl-wish-person__name">@p.Kurzname</div>
                                            <div class="app-wl-wish-person__role">
                                                @(p.HatWunschAbgegeben ? "abgegeben" : "ausstehend")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (wp.WeiterePersonen.Count > 0)
                        {
                            <details class="app-wl-wish-mehr">
                                <summary class="app-wl-wish-mehr__toggle">
                                    <i class="bi bi-chevron-down app-wl-wish-mehr__icon"></i>
                                    <span class="app-wl-wish-mehr__label-closed">
                                        + @wp.WeiterePersonen.Count weitere
                                        @if (wp.WeitereAusstehend > 0)
                                        {
                                            <span class="app-wl-progress-info__warn">(@wp.WeitereAusstehend ausstehend)</span>
                                        }
                                    </span>
                                    <span class="app-wl-wish-mehr__label-open">weniger anzeigen</span>
                                </summary>
                                <div class="app-wl-wish-grid app-wl-wish-grid--mehr">
                                    @foreach (var p in wp.WeiterePersonen)
                                    {
                                        <div class="app-wl-wish-person @(p.HatWunschAbgegeben ? "app-wl-wish-person--done" : "")">
                                            <div class="app-wl-wish-person__avatar">@p.Kuerzel</div>
                                            <div>
                                                <div class="app-wl-wish-person__name">@p.Kurzname</div>
                                                <div class="app-wl-wish-person__role">
                                                    @(p.HatWunschAbgegeben ? "abgegeben" : "ausstehend")
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </details>
                        }

                        <div class="app-wl-wish-footer">
                            <span>&nbsp;</span>
                            @if (Model.HatDienstplan)
                            {
                                <a asp-area="Intensivtransport"
                                   asp-controller="DienstplanWachleiter"
                                   asp-action="Index"
                                   class="app-btn app-btn-neutral app-btn-sm"
                                   data-app-loading-link
                                   data-app-loading-text="Dienstplan wird geöffnet...">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Zum Dienstplan
                                </a>
                            }
                        </div>
                    </div>
                }
                else if (Model.HatDienstplan)
                {
                    <div class="app-surface">
                        <div class="app-card-hd">
                            <span class="app-card-hd__label">
                                <i class="bi bi-calendar-range"></i>
                                Dienstwünsche
                            </span>
                        </div>
                        <div style="padding: var(--sp-pad); color: var(--outline); font-size: var(--type-body-sm-size); text-align: center;">
                            <i class="bi bi-calendar-x" style="font-size: 1.5rem; display: block; margin-bottom: .5rem;"></i>
                            Aktuell ist keine Wunschphase geöffnet.
                        </div>
                        <div class="app-wl-wish-footer">
                            <span>&nbsp;</span>
                            <a asp-area="Intensivtransport"
                               asp-controller="DienstplanWachleiter"
                               asp-action="Index"
                               class="app-btn app-btn-neutral app-btn-sm"
                               data-app-loading-link
                               data-app-loading-text="Dienstplan wird geöffnet...">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Zum Dienstplan
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    }
    else
    {
        @if (!Model.HatMindestensEinModul)
        {
            <section class="app-surface">
                <div class="app-surface__body">
                    <div class="app-form-note">
                        Für Ihre Rolle sind im Bereich Intensivtransport aktuell keine Module freigeschaltet.
                    </div>
                </div>
            </section>
        }
        else
        {
            <div class="app-dashboard-grid">
                @if (Model.HatDienstplan && Model.IstMitarbeiter)
                {
                    <article class="app-dashboard-card">
                        <div class="app-dashboard-card__body">
                            <div class="app-dashboard-card__meta">Dienstplan</div>
                            <div class="app-dashboard-card__top">
                                <div class="app-dashboard-card__icon"><i class="bi bi-calendar3"></i></div>
                                <div>
                                    <h2 class="app-dashboard-card__title">Dienstwünsche</h2>
                                    <p class="app-dashboard-card__text">Wunschabgabe und persönliche Planung öffnen.</p>
                                </div>
                            </div>
                            <div class="app-dashboard-card__footer">
                                <a asp-area="Intensivtransport"
                                   asp-controller="DienstplanMitarbeiter"
                                   asp-action="Index"
                                   class="app-btn app-btn-outline-accent app-dashboard-action"
                                   data-app-loading-link
                                   data-app-loading-text="Dienstwünsche werden geöffnet...">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Dienstwünsche öffnen
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>

                    <article class="app-dashboard-card">
                        <div class="app-dashboard-card__body">
                            <div class="app-dashboard-card__meta">Dienstplan</div>
                            <div class="app-dashboard-card__top">
                                <div class="app-dashboard-card__icon"><i class="bi bi-clipboard2-check"></i></div>
                                <div>
                                    <h2 class="app-dashboard-card__title">Veröffentlichter Plan</h2>
                                    <p class="app-dashboard-card__text">Den freigegebenen Dienstplan öffnen.</p>
                                </div>
                            </div>
                            <div class="app-dashboard-card__footer">
                                <a asp-area="Intensivtransport"
                                   asp-controller="DienstplanMitarbeiter"
                                   asp-action="Plan"
                                   class="app-btn app-btn-outline-accent app-dashboard-action"
                                   data-app-loading-link
                                   data-app-loading-text="Plan wird geöffnet...">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Plan öffnen
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </article>
                }

                @if (Model.HatEinsatzverwaltung)
                {
                    <article class="app-dashboard-card">
                        <div class="app-dashboard-card__body">
                            <div class="app-dashboard-card__meta">Operativ</div>
                            <div class="app-dashboard-card__top">
                                <div class="app-dashboard-card__icon"><i class="bi bi-clipboard2-pulse"></i></div>
                                <div>
                                    <h2 class="app-dashboard-card__title">Einsatz</h2>
                                    <p class="app-dashboard-card__text">Einsatzübersicht und Dokumentation öffnen.</p>
                                </div>
                            </div>
                            <div class="app-dashboard-card__footer">
                                <button type="button" class="app-btn app-btn-neutral app-dashboard-action" disabled>
                                    <i class="bi bi-hourglass-split"></i>
                                    In Vorbereitung
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>
