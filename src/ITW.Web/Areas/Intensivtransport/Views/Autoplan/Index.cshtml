@using ITW.Dienstplan.Application.Planung
@using ITW.Web.ViewModels.UI
@model ITW.Web.Areas.Intensivtransport.ViewModels.Dienstplan.AutoplanIndexViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = Model.Titel;

    var autoplanReturnUrl = Url.Action("Index", "Autoplan", new
    {
        area = "Intensivtransport",
        periodeId = Model.AusgewaehltePeriodeId,
        modus = Model.AusgewaehlterModus
    }) ?? string.Empty;


    var headerModel = new AppPageHeaderViewModel
    {
        Title = Model.Titel,
        Description = Model.Beschreibung,
        Eyebrow = "Autoplan",
        EyebrowIconCssClass = "bi bi-stars"
    };
}


<div class="app-page app-autoplan-page">
    <header class="app-page-header">
        <partial name="~/Views/Shared/Komponenten/_AppPageHeader.cshtml" model="headerModel" />

        <div class="app-page-actions">
            <a asp-area="Intensivtransport"
               asp-controller="DienstplanWachleiter"
               asp-action="Index"
               class="btn btn-neutral"
               data-app-loading-link
               data-app-loading-text="Übersicht wird geöffnet...">
                <i class="bi bi-arrow-left"></i>Zur Übersicht
            </a>

            @if (Model.AusgewaehltePeriodeId.HasValue)
            {
                <a asp-area="Intensivtransport"
                   asp-controller="DienstplanWachleiter"
                   asp-action="Wachleiterkalender"
                   asp-route-periodeId="@Model.AusgewaehltePeriodeId"
                   class="btn btn-outline-accent"
                   data-app-loading-link
                   data-app-loading-text="Tagesplanung wird geöffnet...">
                    <i class="bi bi-calendar3"></i>Zur Tagesplanung
                </a>
            }
        </div>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="app-autoplan-alert app-autoplan-alert--success">
            <div class="app-autoplan-alert__icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="app-autoplan-alert__title">Erfolgreich gespeichert</div>
                <p class="app-autoplan-alert__text">@successMessage</p>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null || !Model.IsSuccess)
    {
        var finalError = TempData["ErrorMessage"]?.ToString() ?? Model.ErrorMessage ?? "Ein Systemfehler ist aufgetreten.";

        <div class="app-autoplan-alert app-autoplan-alert--danger">
            <div class="app-autoplan-alert__icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <div class="app-autoplan-alert__title">System-Hinweis</div>
                <p class="app-autoplan-alert__text">@finalError</p>
            </div>
        </div>
    }

    <section class="app-autoplan-panel">
        <div class="app-autoplan-panel__body">
            <div class="app-autoplan-setup-grid">
                <form asp-action="Index" method="get" class="app-autoplan-form">
                    <div class="app-autoplan-field">
                        <label class="app-autoplan-field__label">Dienstplanperiode</label>
                        <select name="periodeId" asp-items="Model.PeriodenOptionen" class="form-select app-autoplan-select"></select>
                    </div>

                    <div class="app-autoplan-field">
                        <label class="app-autoplan-field__label">Ausführungsmodus</label>
                        <select name="modus" asp-items="Model.ModusOptionen" class="form-select app-autoplan-select"></select>
                    </div>

                    <div class="app-autoplan-field">
                        <button type="submit"
                                class="btn btn-neutral h-100"
                                data-app-loading-form
                                data-app-loading-text="Vorschau wird geladen...">
                            <i class="bi bi-arrow-repeat me-2"></i>Vorschau laden
                        </button>
                    </div>
                </form>

                @if (Model.AusgewaehltePeriodeId.HasValue && Model.VorschauVerfuegbar)
                {
                    <div class="app-autoplan-side-action">
                        <form asp-action="Ausfuehren" method="post" data-app-loading-form data-app-loading-text="Autoplan wird gespeichert...">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="periodeId" value="@Model.AusgewaehltePeriodeId" />
                            <input type="hidden" name="modus" value="@Model.AusgewaehlterModus" />
                            <button type="submit" class="btn btn-accent">
                                <i class="bi bi-magic me-2"></i>Autoplan speichern
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </section>

    <div class="app-autoplan-info-grid">
        <section class="app-autoplan-info-card">
            <div class="app-autoplan-info-card__body">
                <div class="app-autoplan-info-card__eyebrow">Aktiver Modus</div>
                <h2 class="app-autoplan-info-card__title">
                    @(Model.AusgewaehlterModus == AutomatischePlanungAusfuehrungsmodus.NurOffeneSlotsFuellen
                                        ? "Nur offene Slots füllen"
                                        : "Komplette Neuberechnung")
                </h2>
                <p class="app-autoplan-info-card__text">
                    @if (Model.AusgewaehlterModus == AutomatischePlanungAusfuehrungsmodus.NurOffeneSlotsFuellen)
                    {
                        <text>Bestehende Besetzungen bleiben erhalten. Der Autoplan ergänzt nur noch Lücken.</text>
                    }
                    else
                    {
                        <text>Die Periode wird für planbare Werktage neu bewertet. Bestehende Besetzungen können dabei ersetzt oder entfernt werden.</text>
                    }
                </p>

                <div class="app-autoplan-badge-row mt-3">
                    <span class="badge @(Model.AusgewaehlterModus == AutomatischePlanungAusfuehrungsmodus.NurOffeneSlotsFuellen
                                                                                                ? "bg-primary-subtle text-primary-emphasis border border-primary-subtle"
                                                                                                : "bg-warning-subtle text-warning-emphasis border border-warning-subtle") px-3 py-2">
                        @(Model.AusgewaehlterModus == AutomatischePlanungAusfuehrungsmodus.NurOffeneSlotsFuellen
                                                ? "Nur offene Slots"
                                                : "Komplette Neuberechnung")
                    </span>
                </div>
            </div>
        </section>

        @if (Model.AusgewaehltePeriodeId.HasValue)
        {
            <section class="app-autoplan-info-card">
                <div class="app-autoplan-info-card__body">
                    <div class="app-autoplan-info-card__eyebrow">Planungsstand der Periode</div>
                    <h2 class="app-autoplan-info-card__title">@Model.ArbeitsstandTitel</h2>
                    <p class="app-autoplan-info-card__text">@Model.ArbeitsstandHinweis</p>

                    <div class="app-autoplan-badge-row mt-3">
                        <span class="badge @Model.ArbeitsstandBadgeCssClass px-3 py-2">
                            <i class="bi @(Model.PlanIstFreigegeben ? "bi-check2-circle" : Model.WunschphaseIstOffen ? "bi-pencil-square" : "bi-search") me-2"></i>@Model.ArbeitsstandTitel
                        </span>

                        @if (Model.PlanIstFreigegeben && Model.PlanFreigegebenAm.HasValue)
                        {
                            <span class="badge bg-light text-muted border px-3 py-2">
                                Freigegeben am @Model.PlanFreigegebenAm.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                        }
                    </div>
                </div>
            </section>
        }
    </div>

    @if (Model.VorschauVerfuegbar)
    {
        <div class="row g-3 mb-1">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="app-autoplan-kpi-card">
                    <div class="app-autoplan-kpi-card__body">
                        <div class="app-autoplan-kpi-card__label">Tage ohne Handlungsbedarf</div>
                        <h2 class="app-autoplan-kpi-card__value text-success">@Model.AnzahlTageOhneHandlungsbedarf</h2>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="app-autoplan-kpi-card">
                    <div class="app-autoplan-kpi-card__body">
                        <div class="app-autoplan-kpi-card__label">Tage mit Nacharbeit</div>
                        <h2 class="app-autoplan-kpi-card__value text-warning-emphasis">@Model.AnzahlTageMitNacharbeit</h2>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-4">
                <div class="app-autoplan-kpi-card">
                    <div class="app-autoplan-kpi-card__body">
                        <div class="app-autoplan-kpi-card__label">Kritische Tage</div>
                        <h2 class="app-autoplan-kpi-card__value text-danger">@Model.AnzahlKritischeTage</h2>
                    </div>
                </div>
            </div>
        </div>

        <section class="app-autoplan-change-panel">
            <div class="app-autoplan-change-panel__body">
                <h2 class="app-autoplan-change-panel__title">Was sich beim Speichern ändern würde</h2>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle px-3 py-2">
                        Bleibt wie bisher: @Model.AnzahlUnveraenderteSlots
                    </span>
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle px-3 py-2">
                        Neu dazu: @Model.AnzahlNeuGesetzteSlots
                    </span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2">
                        Wird ausgetauscht: @Model.AnzahlErsetzteSlots
                    </span>
                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle px-3 py-2">
                        Fällt weg: @Model.AnzahlWirdOffenSlots
                    </span>
                    <span class="badge bg-light text-muted border px-3 py-2">
                        Bleibt offen: @Model.AnzahlBleibtOffenSlots
                    </span>
                </div>
            </div>
        </section>

        <section class="app-autoplan-preview-panel">
            <div class="app-autoplan-preview-panel__header d-flex justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="app-autoplan-preview-panel__title">Vorschau für @Model.AusgewaehltePeriodeBezeichnung</h2>
                    <p class="app-autoplan-preview-panel__text">Pro Tag siehst du, ob alles gut aussieht, wo du eingreifen musst und was sich am aktuellen Plan ändern würde.</p>
                </div>

                <span class="badge bg-light text-dark border fw-medium px-3 py-2">
                    @Model.Tage.Count Tag(e)
                </span>
            </div>

            <div class="card-body p-0">
                @if (Model.Tage.Count == 0)
                {
                    <div class="p-4 text-muted">Für diese Periode konnten keine planbaren Tage ermittelt werden.</div>
                }
                else
                {
                    <div class="accordion accordion-flush app-autoplan-accordion" id="autoplanAccordion">
                        @for (var i = 0; i < Model.Tage.Count; i++)
                        {
                            var tag = Model.Tage[i];
                            var collapseId = $"autoplanTag_{i}";

                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header" id="heading_@collapseId">
                                    <button class="accordion-button collapsed bg-white shadow-none px-4 py-3"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="false"
                                            aria-controls="@collapseId">
                                        <div class="w-100 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 pe-3">
                                            <div>
                                                <div class="fw-bold text-dark">@tag.DatumAnzeige</div>
                                                <div class="small text-muted">@tag.Kurzbeschreibung</div>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                                <span class="badge @tag.HandlungsstatusCssClass px-3 py-2">@tag.HandlungsstatusText</span>
                                                <span class="badge @tag.StatusCssClass px-3 py-2">@tag.StatusText</span>
                                            </div>
                                        </div>
                                    </button>
                                </h2>

                                <div id="@collapseId"
                                     class="accordion-collapse collapse"
                                     aria-labelledby="heading_@collapseId"
                                     data-bs-parent="#autoplanAccordion">
                                    <div class="accordion-body p-4 app-autoplan-day-body">
                                        <div class="row g-4">
                                            <div class="col-12 col-xl-7">
                                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                                                        <h6 class="app-overline mb-0">Automatische Besetzung</h6>
                                                    </div>

                                                    <div class="card-body p-4 pt-3">
                                                        <div class="d-flex flex-column gap-3">
                                                            @foreach (var entscheidung in tag.SlotEntscheidungen)
                                                            {
                                                                <div class="app-autoplan-slot-card">
                                                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                                                                        <div>
                                                                            <div class="small text-uppercase text-muted fw-bold mb-1">@entscheidung.SlotBezeichnung</div>
                                                                            <div class="fw-bold text-dark fs-5">@entscheidung.AnzeigeName</div>

                                                                            @if (!string.IsNullOrWhiteSpace(entscheidung.Hauptqualifikation))
                                                                            {
                                                                                <div class="small text-muted">@entscheidung.Hauptqualifikation</div>
                                                                            }

                                                                            @if (entscheidung.HatVorherigeBesetzung && !string.IsNullOrWhiteSpace(entscheidung.VorherigeAnzeigeName))
                                                                            {
                                                                                <div class="small text-muted mt-1">
                                                                                    Vorher: @entscheidung.VorherigeAnzeigeName
                                                                                </div>
                                                                            }
                                                                        </div>

                                                                        <div class="text-md-end d-flex flex-column gap-2">
                                                                            <span class="badge @entscheidung.AenderungsCssClass px-3 py-2">@entscheidung.AenderungsLabel</span>
                                                                            <span class="badge @entscheidung.ZuweisungsCssClass px-3 py-2">@entscheidung.ZuweisungsLabel</span>
                                                                        </div>
                                                                    </div>

                                                                    <div class="mt-3 small text-dark">
                                                                        @entscheidung.Nachricht
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="col-12 col-xl-5">
                                                <div class="card border-0 shadow-sm rounded-4 h-100">
                                                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                                                        <h6 class="app-overline mb-0">Konflikte & Hinweise</h6>
                                                    </div>

                                                    <div class="card-body p-4 pt-3">
                                                        @if (tag.Konflikte.Count == 0)
                                                        {
                                                            <div class="app-autoplan-ok-card h-100">
                                                                <div class="fw-bold text-success mb-1">Kein Konflikt erkannt</div>
                                                                <div class="small text-muted">
                                                                    Für diesen Tag liegt aus Sicht des Autoplans aktuell kein zusätzlicher Konflikthinweis vor.
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="d-flex flex-column gap-3">
                                                                @foreach (var konflikt in tag.Konflikte)
                                                                {
                                                                    <div class="app-autoplan-conflict-card">
                                                                        <div class="mb-2">
                                                                            <span class="badge @konflikt.CssClass px-3 py-2">@konflikt.Label</span>
                                                                        </div>
                                                                        <div class="small text-dark">@konflikt.Nachricht</div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-3 border-top d-flex justify-content-end">
                                            <a asp-area="Intensivtransport"
                                               asp-controller="DienstplanWachleiter"
                                               asp-action="Wachleiterkalender"
                                               asp-route-periodeId="@Model.AusgewaehltePeriodeId"
                                               asp-route-planungsModal="true"
                                               asp-route-planJahr="@tag.Datum.Year"
                                               asp-route-planMonat="@tag.Datum.Month"
                                               asp-route-planTag="@tag.Datum.Day"
                                               asp-route-returnUrl="@autoplanReturnUrl"
                                               class="btn btn-outline-accent"
                                               data-app-loading-link
                                               data-app-loading-text="Tagesplanung wird geöffnet...">
                                                <i class="bi bi-pencil-square me-2"></i>Tag manuell öffnen
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>