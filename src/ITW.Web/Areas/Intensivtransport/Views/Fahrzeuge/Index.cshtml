@using ITW.Fahrzeugmanagement.Domain.Enums
@model ITW.Web.Areas.Intensivtransport.ViewModels.Fahrzeugmanagement.FahrzeugeIndexViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = Model.Titel;

    var fahrzeugeGesamt = Model.Fahrzeuge.Count;

    var aktiveFahrzeuge = Model.Fahrzeuge.Count(x =>
        x.Status == FahrzeugStatus.Aktiv);

    var fahrzeugeInBeobachtung = Model.Fahrzeuge.Count(x =>
        x.Status == FahrzeugStatus.InWartung ||
        x.Status == FahrzeugStatus.Reserviert);

    var fahrzeugeNichtVerfuegbar = Model.Fahrzeuge.Count(x =>
        x.Status == FahrzeugStatus.AusserBetrieb ||
        x.Status == FahrzeugStatus.Archiviert);
}

<div class="app-page itw-vehicle-page">
    <app-page-header title="@Model.Titel"
                     description="Operative Fahrzeugübersicht. Prüftermine und Aufgaben erscheinen automatisch im Dashboard.">
        <a asp-action="Anlegen"
           app-btn="accent"
           data-app-loading-link
           data-app-loading-text="Fahrzeugformular wird geöffnet...">
            <i class="bi bi-plus-circle"></i>
            Fahrzeug anlegen
        </a>
    </app-page-header>

    <section class="itw-vehicle-summary">
        <article class="itw-vehicle-summary-card">
            <span class="itw-vehicle-summary-card__label">Fahrzeuge</span>
            <strong class="itw-vehicle-summary-card__value">@fahrzeugeGesamt</strong>
            <span class="itw-vehicle-summary-card__hint">gesamt erfasst</span>
        </article>

        <article class="itw-vehicle-summary-card">
            <span class="itw-vehicle-summary-card__label">Einsatzbereit</span>
            <strong class="itw-vehicle-summary-card__value">@aktiveFahrzeuge</strong>
            <span class="itw-vehicle-summary-card__hint">Status aktiv</span>
        </article>

        <article class="itw-vehicle-summary-card">
            <span class="itw-vehicle-summary-card__label">Beobachten</span>
            <strong class="itw-vehicle-summary-card__value">@fahrzeugeInBeobachtung</strong>
            <span class="itw-vehicle-summary-card__hint">Wartung oder reserviert</span>
        </article>

        <article class="itw-vehicle-summary-card">
            <span class="itw-vehicle-summary-card__label">Nicht verfügbar</span>
            <strong class="itw-vehicle-summary-card__value">@fahrzeugeNichtVerfuegbar</strong>
            <span class="itw-vehicle-summary-card__hint">außer Betrieb oder archiviert</span>
        </article>
    </section>

    @if (Model.Fahrzeuge.Count == 0)
    {
        <section class="app-surface">
            <div class="app-surface__body">
                <div class="app-empty-state">
                    <div class="app-empty-state__icon">
                        <i class="bi bi-truck-front"></i>
                    </div>

                    <div class="app-empty-state__body">
                        <h2 class="app-empty-state__title">Noch keine Fahrzeuge angelegt</h2>
                        <p class="app-empty-state__text">
                            Lege das erste Fahrzeug an, damit Fahrtenbuch, Tankbelege und Prüfstatus genutzt werden können.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="itw-vehicle-grid">
            @foreach (var fahrzeug in Model.Fahrzeuge)
            {
                <article class="itw-vehicle-card">
                    <header class="itw-vehicle-card__header">
                        <div class="itw-vehicle-identity">
                            <div class="itw-vehicle-identity__icon">
                                <i class="bi bi-truck-front"></i>
                            </div>

                            <div class="itw-vehicle-identity__body">
                                <div class="itw-vehicle-identity__number">
                                    @fahrzeug.InterneNummer
                                </div>

                                <h2 class="itw-vehicle-identity__title">
                                    @fahrzeug.Kennzeichen
                                </h2>

                                <p class="itw-vehicle-identity__text">
                                    @fahrzeug.FahrzeugnameText
                                </p>
                            </div>
                        </div>

                        <span class="app-pill @fahrzeug.StatusBadgeCssClass">
                            @fahrzeug.StatusText
                        </span>
                    </header>

                    <div class="itw-vehicle-card__footer">
                        <a asp-action="Details"
                           asp-route-id="@fahrzeug.FahrzeugId"
                           app-btn="accent sm block"
                           data-app-loading-link
                           data-app-loading-text="Fahrzeugakte wird geöffnet...">
                            <i class="bi bi-folder2-open"></i>
                            Akte öffnen
                        </a>
                    </div>
                </article>
            }
        </section>
    }
</div>
