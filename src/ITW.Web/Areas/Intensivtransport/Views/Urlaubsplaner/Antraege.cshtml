@model ITW.Web.Areas.Intensivtransport.ViewModels.Urlaubsplaner.WachleiterUrlaubsUebersichtViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Urlaubsanträge";
}

<div class="app-page">
    <app-page-header title="Urlaubsanträge"
                     description="Ausstehende Urlaubsanträge der Mitarbeiter prüfen, genehmigen oder ablehnen.">
        <a asp-action="Index"
           class="app-btn app-btn-outline-accent"
           data-app-loading-link
           data-app-loading-text="Urlaubsplaner wird geöffnet...">
            <i class="bi bi-arrow-left"></i>
            Zum Urlaubsplaner
        </a>
    </app-page-header>

    @if (Model.Antraege.Count == 0)
    {
        <section class="app-surface">
            <div class="app-surface__body">
                <div class="app-empty-state">
                    <div class="app-empty-state__icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="app-empty-state__body">
                        <h2 class="app-empty-state__title">Keine ausstehenden Anträge</h2>
                        <p class="app-empty-state__text">
                            Alle Urlaubsanträge wurden bereits bearbeitet.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="app-surface">
            <div class="app-surface__body--table">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 app-table">
                        <thead>
                            <tr>
                                <th>Mitarbeiter</th>
                                <th>Zeitraum</th>
                                <th class="text-center">Tage</th>
                                <th>Hinweis</th>
                                <th>Notiz</th>
                                <th class="app-table__col-action">Aktionen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var antrag in Model.Antraege)
                            {
                                <tr>
                                    <td><strong>@antrag.MitarbeiterName</strong></td>
                                    <td class="text-nowrap">@antrag.VonAnzeige – @antrag.BisAnzeige</td>
                                    <td class="text-center fw-bold">@antrag.Urlaubstage</td>
                                    <td>
                                        @if (antrag.HatUeberschneidung)
                                        {
                                            <span class="app-pill app-pill--warning">
                                                <i class="bi bi-exclamation-triangle"></i>
                                                Überschneidung
                                            </span>
                                        }
                                    </td>
                                    <td class="text-muted small">@antrag.Notiz</td>
                                    <td>
                                        <div style="display:flex;gap:0.5rem;align-items:center">
                                            <form asp-action="Entscheiden" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="zeitraumId" value="@antrag.ZeitraumId" />
                                                <input type="hidden" name="genehmigt" value="true" />
                                                <button type="submit"
                                                        class="app-btn app-btn-sm app-btn-success"
                                                        data-app-loading-form
                                                        data-app-loading-text="Wird genehmigt...">
                                                    <i class="bi bi-check-lg"></i>
                                                    Genehmigen
                                                </button>
                                            </form>

                                            <button type="button"
                                                    class="app-btn app-btn-sm app-btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#ablehnModal_@antrag.ZeitraumId">
                                                <i class="bi bi-x-lg"></i>
                                                Ablehnen
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        @* Ablehnen-Modals *@
        @foreach (var antrag in Model.Antraege)
        {
            <div class="modal fade"
                 id="ablehnModal_@antrag.ZeitraumId"
                 tabindex="-1"
                 aria-labelledby="ablehnModalLabel_@antrag.ZeitraumId"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title" id="ablehnModalLabel_@antrag.ZeitraumId">
                                Urlaub ablehnen
                            </h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="Entscheiden" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="zeitraumId" value="@antrag.ZeitraumId" />
                            <input type="hidden" name="genehmigt" value="false" />
                            <div class="modal-body">
                                <p class="text-muted small mb-3">
                                    Antrag von <strong>@antrag.MitarbeiterName</strong>
                                    (@antrag.VonAnzeige – @antrag.BisAnzeige)
                                </p>
                                <div class="mb-3">
                                    <label class="app-form-label">Begründung <span class="text-danger">*</span></label>
                                    <textarea name="begruendung"
                                              class="form-control"
                                              rows="3"
                                              maxlength="1000"
                                              placeholder="Warum kann dieser Urlaub nicht genehmigt werden?"
                                              required></textarea>
                                </div>
                                <div class="mb-0">
                                    <label class="app-form-label">Lösungsvorschlag</label>
                                    <textarea name="loesung"
                                              class="form-control"
                                              rows="2"
                                              maxlength="500"
                                              placeholder="z.B. alternativer Zeitraum"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="app-btn app-btn-outline-accent" data-bs-dismiss="modal">
                                    Abbrechen
                                </button>
                                <button type="submit"
                                        class="app-btn app-btn-danger"
                                        data-app-loading-form
                                        data-app-loading-text="Wird abgelehnt...">
                                    <i class="bi bi-x-circle"></i>
                                    Ablehnen bestätigen
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>
