@model ITW.Web.Areas.Intensivtransport.ViewModels.Urlaubsplaner.WachleiterJahresuebersichtViewModel

@{
    Layout = ViewData["AreaLayoutPath"]?.ToString();
    ViewData["Title"] = "Urlaubsplaner";

    var successMessage = TempData[ITW.Web.UI.Feedback.FlashKeys.Success]?.ToString();
    var errorMessage   = TempData[ITW.Web.UI.Feedback.FlashKeys.Error]?.ToString();
}

<div class="app-page">
    <app-page-header title="Urlaubsplaner"
                     description="Jahresübersicht – alle Mitarbeiter auf einen Blick, Überschneidungen sofort erkennbar.">
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <form method="get" class="d-flex align-items-center gap-2">
                <select name="jahr" class="form-select form-select-sm" style="width:auto"
                        onchange="this.form.submit()">
                    @foreach (var j in Model.JahrOptionen)
                    {
                        if (j == Model.Jahr)
                        {
                            <option value="@j" selected>@j</option>
                        }
                        else
                        {
                            <option value="@j">@j</option>
                        }
                    }
                </select>
            </form>

            @if (Model.AnzahlAusstehend > 0)
            {
                <a asp-action="Antraege"
                   class="app-btn app-btn-accent"
                   data-app-loading-link
                   data-app-loading-text="Anträge werden geladen...">
                    <i class="bi bi-inbox-fill"></i>
                    @Model.AnzahlAusstehend @(Model.AnzahlAusstehend == 1 ? "Antrag" : "Anträge") offen
                </a>
            }
            else
            {
                <a asp-action="Antraege"
                   class="app-btn app-btn-outline-accent"
                   data-app-loading-link
                   data-app-loading-text="Anträge werden geladen...">
                    <i class="bi bi-calendar-check"></i>
                    Urlaubsanträge
                </a>
            }
        </div>
    </app-page-header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        @await Html.PartialAsync("~/Views/Shared/Komponenten/_AppStatusMessage.cshtml", successMessage,
            new ViewDataDictionary(ViewData) { ["Variant"] = "success", ["Title"] = "Gespeichert", ["AutoHide"] = true, ["AutoHideMilliseconds"] = 3000 })
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        @await Html.PartialAsync("~/Views/Shared/Komponenten/_AppStatusMessage.cshtml", errorMessage,
            new ViewDataDictionary(ViewData) { ["Variant"] = "danger", ["Title"] = "Fehler", ["AutoHide"] = false })
    }

    @if (Model.Ueberschneidungen.Count > 0)
    {
        <div class="app-callout app-callout--warning mb-3">
            <i class="bi bi-exclamation-triangle-fill app-callout__icon"></i>
            <div class="app-callout__body">
                <strong>@Model.Ueberschneidungen.Count @(Model.Ueberschneidungen.Count == 1 ? "Überschneidung" : "Überschneidungen") erkannt</strong>
                @foreach (var u in Model.Ueberschneidungen)
                {
                    <div class="mt-1">@u.DatumText — @u.AnzeigeText</div>
                }
            </div>
        </div>
    }

    <section class="app-surface">
        <div class="app-surface__body">

            @if (Model.Mitarbeiter.Count == 0)
            {
                <div class="app-empty-state">
                    <div class="app-empty-state__icon"><i class="bi bi-calendar-heart"></i></div>
                    <div class="app-empty-state__body">
                        <h2 class="app-empty-state__title">Keine Urlaubsdaten für @Model.Jahr</h2>
                        <p class="app-empty-state__text">Noch keine Urlaubszeiträume oder -anträge für dieses Jahr vorhanden.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="urlaub-gantt">
                    @* Monatslinien (im Hintergrund) + Monatsbezeichnung im Header *@
                    <div class="urlaub-gantt__header">
                        <div class="urlaub-gantt__label-col"></div>
                        <div class="urlaub-gantt__track-col" style="position:relative">
                            @foreach (var marker in Model.Monatsmarker)
                            {
                                <span class="urlaub-gantt__monat-label"
                                      style="left:@marker.LeftPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%">
                                    @marker.Name
                                </span>
                            }
                        </div>
                        <div class="urlaub-gantt__tage-col"></div>
                    </div>

                    @* Mitarbeiter-Zeilen *@
                    @foreach (var ma in Model.Mitarbeiter)
                    {
                        <div class="urlaub-gantt__row">
                            <div class="urlaub-gantt__label-col" title="@ma.AnzeigeName">
                                @ma.AnzeigeName
                            </div>
                            <div class="urlaub-gantt__track-col">
                                <div class="urlaub-gantt__track">
                                    @* Monatslinien als Overlay *@
                                    @foreach (var marker in Model.Monatsmarker.Skip(1))
                                    {
                                        <div class="urlaub-gantt__monat-line"
                                             style="left:@marker.LeftPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%">
                                        </div>
                                    }
                                    @* Überschneidungszonen *@
                                    @foreach (var u in Model.Ueberschneidungen)
                                    {
                                        <div class="urlaub-gantt__overlap-zone"
                                             style="left:@u.LeftPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%;width:@u.WidthPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%"
                                             title="Überschneidung: @u.AnzeigeText (@u.DatumText)">
                                        </div>
                                    }
                                    @* Urlaubsbalken *@
                                    @foreach (var balken in ma.Balken)
                                    {
                                        var barClass = balken.Status == ITW.Domain.Personnel.Enums.UrlaubszeitraumStatus.Ausstehend
                                            ? "urlaub-gantt__bar--ausstehend"
                                            : "urlaub-gantt__bar--genehmigt";
                                        var overlapClass = balken.HatUeberschneidung ? " urlaub-gantt__bar--conflict" : "";
                                        <div class="urlaub-gantt__bar @barClass@overlapClass"
                                             style="left:@balken.LeftPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%;width:@balken.WidthPercent.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)%"
                                             title="@balken.TooltipText">
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="urlaub-gantt__tage-col">
                                @if (ma.GesamtTage > 0)
                                {
                                    <span>@ma.GesamtTage T</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* Legende *@
                <div class="urlaub-gantt__legend">
                    <span class="urlaub-gantt__legend-item">
                        <span class="urlaub-gantt__legend-dot urlaub-gantt__legend-dot--genehmigt"></span>
                        Genehmigt
                    </span>
                    <span class="urlaub-gantt__legend-item">
                        <span class="urlaub-gantt__legend-dot urlaub-gantt__legend-dot--ausstehend"></span>
                        Ausstehend
                    </span>
                    @if (Model.Ueberschneidungen.Count > 0)
                    {
                        <span class="urlaub-gantt__legend-item">
                            <span class="urlaub-gantt__legend-dot urlaub-gantt__legend-dot--overlap"></span>
                            Überschneidung
                        </span>
                    }
                </div>
            }
        </div>
    </section>
</div>
